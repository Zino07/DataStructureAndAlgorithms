# Copy to .env for production/local runs (chmod 600 .env). Never commit .env.
# Admin stays disabled (503) unless ADMIN_PIN is 8+ characters and not a weak default.
ADMIN_PIN=replace-with-a-strong-pin

# Standalone server bind settings (used by server.py / restart.sh on VPS)
HOST=127.0.0.1
PORT=8124

# Set TRUST_PROXY=1 on Octenium (cPanel Nginx/Apache proxy or VPS behind Nginx)
# Set TRUST_PROXY=0 only when exposing server.py directly during local testing
TRUST_PROXY=1
BEHIND_TLS=1

# Optional: custom SQLite database path (default: data/noor.sqlite3)
# NOOR_DB=data/noor.sqlite3

# Optional: Upstash Redis REST credentials (for serverless / multi-node setups)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
