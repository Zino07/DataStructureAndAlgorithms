# Copy to .env in the application folder and run: chmod 600 .env
# Never commit .env or share it. Restart the app (cPanel -> Setup Python App
# -> Restart) after every change.

# --- Admin sign-in ---------------------------------------------------------
# One-time PIN for the very first sign-in (8+ characters, not a common word).
# After you create your username + password in Admin -> Settings, the PIN
# stops working. You may then delete this line; set it again only if you ever
# need `python3 manage.py reset-admin`.
ADMIN_PIN=replace-with-a-strong-pin

# --- Server ----------------------------------------------------------------
# Set TRUST_PROXY=1 on Octenium cPanel (Apache/LiteSpeed proxy in front of the app)
TRUST_PROXY=1
BEHIND_TLS=1
# Only used by server.py / restart.sh (not by cPanel Passenger)
HOST=127.0.0.1
PORT=8124

# Public address of the shop, used in password-reset links
SITE_URL=https://yourdomain.dz

# --- Email (cPanel -> Email Accounts -> Connect Devices shows these) --------
# Leave SMTP_HOST empty to turn all email off.
SMTP_HOST=mail.yourdomain.dz
SMTP_PORT=465
SMTP_USER=orders@yourdomain.dz
SMTP_PASSWORD=replace-with-the-mailbox-password
MAIL_FROM=orders@yourdomain.dz
MAIL_FROM_NAME=Kaser Abd Alaziz
# New-order alerts and error alerts go here
ADMIN_EMAIL=you@example.com
# A daily database backup is emailed here (use a mailbox outside this server,
# e.g. Gmail). Leave empty to keep backups on the server only.
BACKUP_EMAIL=

# --- Optional ----------------------------------------------------------------
# NOOR_DB=data/noor.sqlite3      # database path
# BACKUP_EVERY=86400             # seconds between automatic backups (0 = off)
# BACKUP_KEEP=14                 # backups kept in data/backups
