// Bento Neo tokens. Values mirror tokens.json / tokens.css of the design system.
// Two styles: Bento (eight solid themes: four palettes in light and dark) and
// Aurora Glass (dark frosted panels over a blurred aurora tinted by the accent).

export struct Palette {
    canvas: color,
    surface: color,
    surface-muted: color,
    surface-inverse: color,
    ink: color,
    ink-muted: color,
    ink-subtle: color,
    ink-inverse: color,
    line: color,
    accent: color,
    on-accent: color,
    accent-soft: color,
    accent-ink: color,
    positive: color,
    negative: color,
}

export global Theme {
    // 0 lime, 1 solar, 2 ember, 3 lilac
    in-out property <int> palette: 0;
    in-out property <bool> dark: false;
    // Aurora Glass style. Always dark: the glass needs a dark, busy backdrop.
    in-out property <bool> glass: false;
    out property <bool> is-dark: dark || glass;

    property <[Palette]> themes: [
        // lime-light
        { canvas: #e8e8e5, surface: #ffffff, surface-muted: #f3f3f1, surface-inverse: #111111,
          ink: #111111, ink-muted: #5c5c58, ink-subtle: #8c8c86, ink-inverse: #ffffff, line: #dcdcd8,
          accent: #d4ff3a, on-accent: #111111, accent-soft: #effcc4, accent-ink: #4a6600,
          positive: #177a40, negative: #d1343a },
        // lime-dark
        { canvas: #0c0c0c, surface: #1a1a1a, surface-muted: #242424, surface-inverse: #f4f4f1,
          ink: #f4f4f1, ink-muted: #a6a6a0, ink-subtle: #6e6e69, ink-inverse: #111111, line: #2e2e2e,
          accent: #d4ff3a, on-accent: #111111, accent-soft: #2a3310, accent-ink: #d4ff3a,
          positive: #5bd68a, negative: #ff6b6b },
        // solar-light
        { canvas: #ebe9e1, surface: #fffef9, surface-muted: #f6f4ec, surface-inverse: #111111,
          ink: #111111, ink-muted: #5c5c58, ink-subtle: #8c8c86, ink-inverse: #ffffff, line: #dcdcd8,
          accent: #ffe53b, on-accent: #111111, accent-soft: #fff6c4, accent-ink: #6b5a00,
          positive: #177a40, negative: #d1343a },
        // solar-dark
        { canvas: #0d0c09, surface: #1b1a16, surface-muted: #25241f, surface-inverse: #f4f4f1,
          ink: #f4f4f1, ink-muted: #a6a6a0, ink-subtle: #6e6e69, ink-inverse: #111111, line: #2e2e2e,
          accent: #ffe53b, on-accent: #111111, accent-soft: #332f10, accent-ink: #ffe53b,
          positive: #5bd68a, negative: #ff6b6b },
        // ember-light
        { canvas: #ebe8e5, surface: #fffdfb, surface-muted: #f5f2ef, surface-inverse: #111111,
          ink: #111111, ink-muted: #5c5c58, ink-subtle: #8c8c86, ink-inverse: #ffffff, line: #dcdcd8,
          accent: #ff7a2f, on-accent: #111111, accent-soft: #ffe2d0, accent-ink: #a33d00,
          positive: #177a40, negative: #d1343a },
        // ember-dark
        { canvas: #0d0b0a, surface: #1c1917, surface-muted: #26221f, surface-inverse: #f4f4f1,
          ink: #f4f4f1, ink-muted: #a6a6a0, ink-subtle: #6e6e69, ink-inverse: #111111, line: #2e2e2e,
          accent: #ff7a2f, on-accent: #111111, accent-soft: #3a2213, accent-ink: #ff8f52,
          positive: #5bd68a, negative: #ff6b6b },
        // lilac-light
        { canvas: #e8e7ec, surface: #fefeff, surface-muted: #f3f2f7, surface-inverse: #111111,
          ink: #111111, ink-muted: #5c5c58, ink-subtle: #8c8c86, ink-inverse: #ffffff, line: #dcdcd8,
          accent: #c6b3ff, on-accent: #111111, accent-soft: #ece6ff, accent-ink: #5638c2,
          positive: #177a40, negative: #d1343a },
        // lilac-dark
        { canvas: #0b0b0e, surface: #19181e, surface-muted: #232229, surface-inverse: #f4f4f1,
          ink: #f4f4f1, ink-muted: #a6a6a0, ink-subtle: #6e6e69, ink-inverse: #111111, line: #2e2e2e,
          accent: #c6b3ff, on-accent: #111111, accent-soft: #251f3a, accent-ink: #c6b3ff,
          positive: #5bd68a, negative: #ff6b6b },
    ];

    // Swatches for the palette picker.
    out property <[color]> accents: [#d4ff3a, #ffe53b, #ff7a2f, #c6b3ff];
    property <color> accent-now: accents[Math.clamp(palette, 0, 3)];

    // Aurora Glass: "surface" fills are light vibrancy fills that sit on glass
    // or on the aurora; panels themselves are drawn by GlassFill.
    property <Palette> glass-palette: {
        canvas: #050607, surface: #ffffff17, surface-muted: #ffffff12, surface-inverse: #f4f4f1,
        ink: #f7f7f4, ink-muted: #ffffffc4, ink-subtle: #ffffff73, ink-inverse: #111111, line: #ffffff24,
        accent: accent-now, on-accent: #111111, accent-soft: accent-now.with-alpha(0.16), accent-ink: accent-now,
        positive: #74e8a2, negative: #ff8080 };

    out property <Palette> c: glass ? glass-palette : themes[Math.clamp(palette, 0, 3) * 2 + (dark ? 1 : 0)];

    // Spacing
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;

    // Radius
    out property <length> radius-xs: 10px;
    out property <length> radius-sm: 16px;
    out property <length> radius-md: 20px;
    out property <length> radius-lg: 28px;
    out property <length> radius-xl: 40px;

    // Controls
    out property <length> control-sm: 32px;
    out property <length> control-md: 40px;
    out property <length> control-lg: 48px;

    // Mobile gap between tiles
    out property <length> gap: 12px;
    // Side margin of every screen
    out property <length> margin: 16px;
}

// Type scale (size, weight, tracking). Mobile sizes.
export global Type {
    out property <length> display: 40px;      // page title (64px on desktop)
    out property <length> metric-xl: 48px;    // hero number
    out property <length> metric-md: 32px;    // number inside a card
    out property <length> metric-sm: 22px;    // number inside a half-width card
    out property <length> h1: 28px;
    out property <length> h2: 20px;
    out property <length> h3: 16px;           // card title
    out property <length> body: 15px;
    out property <length> label: 13px;
    out property <length> caption: 12px;      // 11px in the web kit; 12px reads better on phones
    out property <length> micro: 10px;        // chart axes
}

// Motion tokens (see docs/MOTION_AND_GLASS_RESEARCH.md). Springs use Apple's
// duration/bounce model: duration is perceptual, the tail may run longer, so
// no logic ever waits for an animation. Bounce only follows a gesture with
// momentum; taps get bounce 0 or a small brisk tail.
export global Motion {
    // in-app "Reduce motion": springs become instant, entrances only fade
    in-out property <bool> reduce: false;
    out property <duration> smooth: reduce ? 0ms : 450ms;   // spring(0): screens, morphs
    out property <duration> snappy: reduce ? 0ms : 380ms;   // spring(0.15): indicators, selection
    out property <duration> press: reduce ? 0ms : 260ms;    // spring(0.2): press scale release
    out property <duration> quick: reduce ? 120ms : 200ms;  // fades, colour changes
    out property <duration> stagger: reduce ? 0ms : 40ms;   // between cards entering
    out property <float> rise: reduce ? 1 : 0.96;           // entering cards start at this scale
}

// Frosted glass. Slint has no backdrop blur. Aurora Glass draws a blurred
// copy of the fixed backdrop inside each panel (aligned to the window), plus
// a tint, a sheen and a lit edge. Bento uses a dense tint with a light edge.
export global Glass {
    // dark glass for the dock, toasts and sheets (same in light and dark mode)
    out property <color> dark: #141414e6;
    out property <color> dark-edge: #ffffff1f;
    out property <color> dark-ink: #f4f4f1;
    out property <color> dark-muted: #f4f4f1a3;
    // canvas-tinted glass for the top bar
    out property <color> bar: Theme.c.canvas.with-alpha(0.94);
    out property <color> bar-edge: Theme.is-dark ? #ffffff1a : #00000014;
    out property <color> scrim: #00000073;

    // ---- Aurora Glass ----
    // in-app "Reduce transparency": solid panels, no backdrop showing through
    in-out property <bool> solid: false;
    in-out property <image> backdrop;      // full-window aurora with grain
    in-out property <image> frost;         // heavily blurred copy for panels
    in-out property <image> grain;         // small noise tile
    // window size and scroll parallax, set by the window
    in-out property <length> win-width: 390px;
    in-out property <length> win-height: 844px;
    in-out property <length> shift: 0px;
    out property <length> travel: 80px;    // how far the backdrop can drift
    // panel tints over the frost (checked for contrast in aurora.rs tests)
    out property <color> tint: #0a0d10a6;
    out property <color> tint-hero: #0a0d10a6;
    out property <color> tint-accent: #0a0d10b3;
    out property <color> tint-solid: #15181b;
    out property <brush> edge: @linear-gradient(155deg, #ffffff5c 0%, #ffffff14 38%, #ffffff0a 62%, #ffffff29 100%);
    out property <brush> sheen: @linear-gradient(170deg, #ffffff1a 0%, #ffffff05 30%, #ffffff00 55%);
}

// Line icons on a 24 × 24 grid, drawn with a 1.8 stroke and round caps.
export global Icons {
    out property <string> arrow-up-right: "M7 17 17 7M8 7h9v9";
    out property <string> arrow-up: "M12 19V5M6 11l6-6 6 6";
    out property <string> arrow-down: "M12 5v14M6 13l6 6 6-6";
    out property <string> back: "M15 18 9 12l6-6";
    out property <string> close: "M6 6l12 12M18 6 6 18";
    out property <string> plus: "M12 5v14M5 12h14";
    out property <string> minus: "M5 12h14";
    out property <string> grid: "M4 6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM14 6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2zM4 16a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM14 16a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2z";
    out property <string> activity: "M3 12h4l3-8 4 16 3-8h4";
    out property <string> chart: "M4 20V10M10 20V4M16 20v-7M22 20H2";
    out property <string> wallet: "M4 7h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7l2-3h10M16 14h.01";
    out property <string> sliders: "M4 7h9M17 7h3M15 5v4M4 17h3M11 17h9M9 15v4";
    out property <string> calendar: "M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1zM4 10h16M8 3v5M16 3v5";
    out property <string> clock: "M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0-18 0M12 7v5l3 2";
    out property <string> search: "M11 11m-7 0a7 7 0 1 0 14 0a7 7 0 1 0-14 0M20 20l-4-4";
    out property <string> trash: "M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3";
    out property <string> edit: "M4 20h4L19 9l-4-4L4 16zM13 7l4 4";
    out property <string> swap: "M7 7h13l-4-4M17 17H4l4 4";
    out property <string> backspace: "M20 6H9l-6 6 6 6h11a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1zM16 10l-4 4M12 10l4 4";
    out property <string> check: "M5 12l5 5 9-10";
    out property <string> alert: "M12 8v5M12 16.5h.01M10.3 3.9 2.4 17.5A2 2 0 0 0 4.1 20.5h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z";
    out property <string> sparkle: "M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z";
    out property <string> radar: "M12 12m-8 0a8 8 0 1 0 16 0a8 8 0 1 0-16 0M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0-8 0M12 12 18 6";
}
