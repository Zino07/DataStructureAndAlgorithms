import { Theme, Type, Icons } from "../theme.slint";
import { Tile, TileStyle, PillNav, Caption, CardTitle, Amount, PageTitle, Bars, Bar, DotMatrix, Figure,
         Badge, Progress, ListRow, Icon, IconButton, IconButtonStyle, ChipScroller, Chip, CardHeader, Ink } from "../components/bento.slint";

// One rate in the money clock: label, the hourly figure big, per minute below.
component Rate inherits VerticalLayout {
    in property <string> caption;
    in property <string> value;
    in property <string> per-minute;
    in property <int> fit-chars;
    in property <color> accent: Ink.fg(TileStyle.inverse);
    horizontal-stretch: 1;
    preferred-width: 1px;
    spacing: 2px;
    Caption { text: root.caption; on: TileStyle.inverse; }
    Amount { value: root.value; size: Type.metric-md; fit-chars: root.fit-chars; on: TileStyle.inverse; color: root.accent; }
    Text {
        text: root.per-minute;
        font-size: Type.label;
        font-weight: 600;
        color: Ink.muted(TileStyle.inverse);
        overflow: elide;
    }
}

// Small figure inside the money clock.
component ClockCell inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    horizontal-stretch: 1;
    height: 56px;
    border-radius: Theme.radius-sm;
    background: Theme.glass ? #ffffff10 : Theme.c.ink-inverse.with-alpha(0.08);
    border-width: Theme.glass ? 1px : 0px;
    border-color: #ffffff12;
    VerticalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        alignment: center;
        spacing: 2px;
        Caption { text: root.caption; on: TileStyle.inverse; }
        Text { text: root.value; font-size: Type.body; font-weight: 600; color: Ink.fg(TileStyle.inverse); overflow: elide; }
    }
}
import { StatsView, CategoryShare, TxRow, Insight } from "../data.slint";

export component StatsScreen inherits VerticalLayout {
    in property <StatsView> stats;
    in property <string> currency;
    in property <string> clock;
    in property <[Bar]> flow;
    in property <[Bar]> hours;
    in property <[string]> week-labels;
    in property <[float]> heat;
    in property <int> heat-peak;
    in property <[CategoryShare]> categories;
    in property <[TxRow]> largest;
    in property <[Insight]> insights;
    in-out property <int> range: 0;
    in property <bool> has-cut;   // one cash-flow bar is off the scale
    callback range-changed(int);
    callback open-budgets();
    callback edit(int);

    spacing: Theme.gap;

    PageTitle { first: "Deep"; second: "Stats"; }

    ChipScroller {
        for name[i] in ["This cycle", "Last cycle", "90 days", "12 months"]: Chip {
            text: name;
            active: root.range == i;
            clicked => {
                root.range = i;
                root.range-changed(i);
            }
        }
    }

    // money clock: every rate per hour (big) and per minute (below)
    Tile {
        style: TileStyle.inverse;
        inner-spacing: Theme.space-4;
        order: 0;
        CardHeader {
            title: "Money clock";
            icon: Icons.clock;
            on: TileStyle.inverse;
            Rectangle {
                height: 28px;
                y: (parent.height - self.height) / 2;
                width: clock-text.preferred-width + 20px;
                border-radius: 14px;
                background: Theme.c.accent;
                clock-text := Text {
                    text: root.clock;
                    font-size: Type.label;
                    font-weight: 700;
                    color: Theme.c.on-accent;
                }
            }
        }
        Caption { text: root.stats.range-label + " · " + root.stats.elapsed; on: TileStyle.inverse; }
        HorizontalLayout {
            spacing: Theme.space-4;
            Rate {
                caption: "Earned per hour";
                value: "+" + root.stats.earn-hour;
                per-minute: "+" + root.stats.earn-minute + " a minute";
                fit-chars: Math.max(root.stats.earn-hour.character-count, root.stats.burn-hour.character-count) + 1;
            }
            Rectangle { width: 1px; background: Theme.glass ? #ffffff1a : Theme.c.ink-inverse.with-alpha(0.14); }
            Rate {
                caption: "Spent per hour";
                value: "−" + root.stats.burn-hour;
                per-minute: "−" + root.stats.burn-minute + " a minute";
                fit-chars: Math.max(root.stats.earn-hour.character-count, root.stats.burn-hour.character-count) + 1;
            }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            ClockCell { caption: "Per working hour"; value: root.stats.earn-work-hour; }
            ClockCell { caption: "Spent per day"; value: root.stats.burn-day; }
        }
    }

    if !root.stats.has-data: Tile {
        CardTitle { text: "No entries in this range"; }
        Text {
            text: "Statistics appear as soon as you log income or spending. Every entry is timed to the minute.";
            wrap: word-wrap;
            font-size: Type.label;
            color: Theme.c.ink-muted;
        }
    }

    if root.stats.has-data: HorizontalLayout {
        spacing: Theme.gap;
        Tile {
            horizontal-stretch: 1;
            style: TileStyle.soft;
            pad: Theme.space-5;
            inner-spacing: Theme.space-2;
            order: 1;
            CardHeader { title: "Net"; on: TileStyle.soft; }
            Amount { value: root.stats.net; size: Type.metric-sm; on: TileStyle.soft; color: root.stats.net-negative ? Theme.c.negative : Ink.fg(TileStyle.soft); fit-chars: Math.max(root.stats.net.character-count, root.stats.runway.character-count); }
            Caption { text: "Saved " + root.stats.savings-rate + " of income"; on: TileStyle.soft; }
        }
        Tile {
            horizontal-stretch: 1;
            pad: Theme.space-5;
            inner-spacing: Theme.space-2;
            order: 1;
            CardHeader { title: "Runway"; }
            Amount { value: root.stats.runway; size: Type.metric-sm; fit-chars: Math.max(root.stats.net.character-count, root.stats.runway.character-count); }
            Caption { text: "balance at this pace"; }
        }
    }

    if root.stats.has-data: Tile {
        inner-spacing: Theme.space-3;
        order: 2;
        CardHeader {
            title: "Cash flow";
            badge: root.stats.expense-delta;
            badge-up: root.stats.expense-up;
            badge-bad: root.stats.expense-up;
        }
        HorizontalLayout {
            spacing: Theme.space-4;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Caption { text: "Income"; }
                Text { text: "+" + root.stats.income; font-size: Type.body; font-weight: 600; color: Theme.c.positive; overflow: elide; }
            }
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Caption { text: "Spent"; }
                Text { text: "−" + root.stats.expense; font-size: Type.body; font-weight: 600; color: Theme.c.ink; overflow: elide; }
            }
        }
        Bars {
            bars: root.flow;
            chart-height: 96px;
            gap: root.flow.length > 20 ? 3px : root.flow.length > 10 ? 6px : 8px;
        }
        Caption {
            text: "Spending per " + (root.flow.length > 20 ? "day" : root.flow.length > 10 ? "week" : "month")
                + (root.has-cut ? " · a notched bar is off the scale" : "")
                + " · vs. before: " + (root.stats.expense-delta == "" ? "no data" : (root.stats.expense-up ? "up " : "down ") + root.stats.expense-delta);
            wrap: word-wrap;
        }
    }

    if root.stats.has-data: Tile {
        inner-spacing: Theme.space-3;
        order: 3;
        CardHeader { title: "Purchases by hour"; }
        Caption { text: "Busiest " + root.stats.peak-hour + " · " + root.stats.night-share + " of spending after 20:00"; }
        Bars {
            bars: root.hours;
            chart-height: 80px;
            gap: 3px;
        }
    }

    if root.stats.has-data: Tile {
        inner-spacing: Theme.space-3;
        order: 4;
        CardHeader { title: "Week × hour"; }
        Caption { text: "Each dot is one hour; bigger means more purchases. Busiest day: " + root.stats.peak-day + "."; wrap: word-wrap; }
        DotMatrix {
            row-labels: root.week-labels;
            cells: root.heat;
            peak: root.heat-peak;
        }
    }

    if root.stats.has-data: Tile {
        inner-spacing: Theme.space-5;
        order: 5;
        CardHeader { title: "Habits"; }
        HorizontalLayout {
            spacing: Theme.space-4;
            Figure { horizontal-stretch: 1; caption: "Entries"; value: root.stats.entries; note: root.stats.entries-per-day; }
            Figure { horizontal-stretch: 1; caption: "One purchase"; value: root.stats.gap; note: "on average between two"; }
        }
        HorizontalLayout {
            spacing: Theme.space-4;
            Figure { horizontal-stretch: 1; caption: "Average spend"; value: root.stats.avg; note: "median " + root.stats.median; }
            Figure { horizontal-stretch: 1; caption: "Costs you"; value: root.stats.work-cost; note: "of work per purchase"; }
        }
        HorizontalLayout {
            spacing: Theme.space-4;
            Figure { horizontal-stretch: 1; caption: "Weekday"; value: root.stats.weekday-avg; note: "spent per day"; }
            Figure { horizontal-stretch: 1; caption: "Weekend"; value: root.stats.weekend-avg; note: "spent per day"; }
        }
        HorizontalLayout {
            spacing: Theme.space-4;
            Figure { horizontal-stretch: 1; caption: "No-spend days"; value: root.stats.no-spend; note: root.stats.streak; }
            Figure { horizontal-stretch: 1; caption: "Income change"; value: root.stats.income-delta == "" ? "—" : (root.stats.income-up ? "+" : "−") + root.stats.income-delta; note: "vs. same length before"; }
        }
    }

    if root.insights.length > 0: Tile {
        style: TileStyle.soft;
        inner-spacing: Theme.space-3;
        order: 6;
        CardHeader { title: "Insights"; icon: Icons.sparkle; on: TileStyle.soft; }
        for i in root.insights: HorizontalLayout {
            spacing: Theme.space-3;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: i.warning ? Theme.c.negative : Theme.glass ? #ffffff1a : Theme.c.surface;
                Icon { data: i.icon; size: 16px; stroke: i.warning ? #ffffff : Theme.c.ink; }
            }
            Text {
                text: i.text;
                wrap: word-wrap;
                font-size: Type.label;
                font-weight: 500;
                color: Theme.c.ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }

    if root.categories.length > 0: Tile {
        inner-spacing: Theme.space-4;
        order: 7;
        CardHeader {
            title: "Categories";
            action-icon: Icons.sliders;
            action-label: "Set budgets";
            action => { root.open-budgets(); }
        }
        for cat in root.categories: VerticalLayout {
            spacing: Theme.space-2;
            HorizontalLayout {
                spacing: Theme.space-2;
                Icon { data: cat.icon; y: (parent.height - self.height) / 2; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text { text: cat.name; font-size: Type.label; font-weight: 600; color: Theme.c.ink; overflow: elide; }
                    Caption { text: cat.count + (cat.budget != "" ? " · " + cat.budget : ""); }
                }
                VerticalLayout {
                    Text { text: cat.amount; font-size: Type.label; font-weight: 600; color: cat.over ? Theme.c.negative : Theme.c.ink; horizontal-alignment: right; }
                    Caption { text: cat.percent; horizontal-alignment: right; }
                }
            }
            Progress {
                value: cat.budget-ratio >= 0 ? cat.budget-ratio : cat.share;
                fill: cat.over ? Theme.c.negative : cat.budget-ratio >= 0 ? Theme.c.accent : Ink.strong(TileStyle.surface);
            }
        }
    }

    if root.largest.length > 0: Tile {
        inner-spacing: Theme.space-1;
        order: 8;
        CardHeader { title: "Biggest purchases"; }
        Rectangle { height: Theme.space-1; }
        for tx in root.largest: ListRow {
            icon: tx.icon;
            title: tx.title;
            meta: tx.meta;
            value: tx.amount;
            value-meta: tx.time;
            clicked => { root.edit(tx.id); }
        }
    }
}
