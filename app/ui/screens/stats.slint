import { Theme, Type, Icons } from "../theme.slint";
import { Tile, TileStyle, PillNav, Caption, CardTitle, Amount, PageTitle, Bars, Bar, DotMatrix, Figure,
         Badge, Progress, ListRow, Icon, IconButton, IconButtonStyle, ChipScroller, Chip } from "../components/bento.slint";
import { StatsView, CategoryShare, TxRow, Insight } from "../data.slint";

export component StatsScreen inherits VerticalLayout {
    in property <StatsView> stats;
    in property <string> currency;
    in property <string> clock;
    in property <[Bar]> flow;
    in property <[Bar]> hours;
    in property <[string]> week-labels;
    in property <[float]> heat;
    in property <int> heat-peak;
    in property <[CategoryShare]> categories;
    in property <[TxRow]> largest;
    in property <[Insight]> insights;
    in-out property <int> range: 0;
    callback range-changed(int);
    callback open-budgets();
    callback edit(int);

    spacing: Theme.gap;

    PageTitle { first: "Deep"; second: "Stats"; }

    ChipScroller {
        for name[i] in ["This cycle", "Last cycle", "90 days", "12 months"]: Chip {
            text: name;
            active: root.range == i;
            clicked => {
                root.range = i;
                root.range-changed(i);
            }
        }
    }

    // money clock: every rate per hour and per minute
    Tile {
        style: TileStyle.inverse;
        inner-spacing: Theme.space-4;
        HorizontalLayout {
            spacing: Theme.space-2;
            Icon { data: Icons.clock; stroke: Theme.c.ink-inverse; y: (parent.height - self.height) / 2; }
            CardTitle { text: "Money clock"; on: TileStyle.inverse; horizontal-stretch: 1; }
            Rectangle {
                height: 28px;
                width: clock-text.preferred-width + 20px;
                border-radius: 14px;
                background: Theme.c.accent;
                clock-text := Text {
                    text: root.clock;
                    font-size: Type.label;
                    font-weight: 700;
                    color: Theme.c.on-accent;
                }
            }
        }
        Caption { text: root.stats.range-label + " · " + root.stats.elapsed; on: TileStyle.inverse; }
        HorizontalLayout {
            spacing: Theme.space-4;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Caption { text: "Earned per hour"; on: TileStyle.inverse; }
                Amount { value: "+" + root.stats.earn-hour; size: Type.metric-sm + 4px; on: TileStyle.inverse; }
                Caption { text: root.stats.earn-minute + " a minute"; on: TileStyle.inverse; }
            }
            Rectangle { width: 1px; background: Theme.c.ink-inverse.with-alpha(0.14); }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Caption { text: "Spent per hour"; on: TileStyle.inverse; }
                Amount { value: "−" + root.stats.burn-hour; size: Type.metric-sm + 4px; on: TileStyle.inverse; }
                Caption { text: root.stats.burn-minute + " a minute"; on: TileStyle.inverse; }
            }
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            Rectangle {
                horizontal-stretch: 1;
                height: 52px;
                border-radius: Theme.radius-sm;
                background: Theme.c.ink-inverse.with-alpha(0.08);
                VerticalLayout {
                    padding-left: Theme.space-3;
                    alignment: center;
                    Caption { text: "Per working hour"; on: TileStyle.inverse; }
                    Text { text: root.stats.earn-work-hour; font-size: Type.body; font-weight: 600; color: Theme.c.ink-inverse; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 52px;
                border-radius: Theme.radius-sm;
                background: Theme.c.ink-inverse.with-alpha(0.08);
                VerticalLayout {
                    padding-left: Theme.space-3;
                    alignment: center;
                    Caption { text: "Spent per day"; on: TileStyle.inverse; }
                    Text { text: root.stats.burn-day; font-size: Type.body; font-weight: 600; color: Theme.c.ink-inverse; }
                }
            }
        }
    }

    if !root.stats.has-data: Tile {
        CardTitle { text: "No entries in this range"; }
        Text {
            text: "Statistics appear as soon as you log income or spending. Every entry is timed to the minute.";
            wrap: word-wrap;
            font-size: Type.label;
            color: Theme.c.ink-muted;
        }
    }

    if root.stats.has-data: HorizontalLayout {
        spacing: Theme.gap;
        Tile {
            horizontal-stretch: 1;
            style: TileStyle.soft;
            pad: Theme.space-5;
            inner-spacing: Theme.space-2;
            CardTitle { text: "Net"; }
            Amount { value: root.stats.net; size: Type.metric-sm + 2px; color: root.stats.net-negative ? Theme.c.negative : Theme.c.ink; }
            Caption { text: "Saved " + root.stats.savings-rate + " of income"; }
        }
        Tile {
            horizontal-stretch: 1;
            pad: Theme.space-5;
            inner-spacing: Theme.space-2;
            CardTitle { text: "Runway"; }
            Amount { value: root.stats.runway; size: Type.metric-sm + 2px; }
            Caption { text: "balance at this pace"; }
        }
    }

    if root.stats.has-data: Tile {
        inner-spacing: Theme.space-3;
        HorizontalLayout {
            spacing: Theme.space-2;
            CardTitle { text: "Cash flow"; horizontal-stretch: 1; }
            if root.stats.expense-delta != "": Badge {
                text: root.stats.expense-delta;
                up: root.stats.expense-up;
                bad: root.stats.expense-up;
                y: (parent.height - self.height) / 2;
            }
        }
        HorizontalLayout {
            spacing: Theme.space-4;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Caption { text: "Income"; }
                Text { text: "+" + root.stats.income; font-size: Type.body; font-weight: 600; color: Theme.c.positive; }
            }
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Caption { text: "Spent"; }
                Text { text: "−" + root.stats.expense; font-size: Type.body; font-weight: 600; color: Theme.c.ink; }
            }
        }
        Bars {
            bars: root.flow;
            chart-height: 96px;
            gap: root.flow.length > 20 ? 3px : root.flow.length > 10 ? 6px : 8px;
        }
        Caption { text: "Spending per " + (root.flow.length > 20 ? "day" : root.flow.length > 10 ? "week" : "month") + " vs. same length before: " + (root.stats.expense-delta == "" ? "no data" : (root.stats.expense-up ? "up " : "down ") + root.stats.expense-delta); }
    }

    if root.stats.has-data: Tile {
        inner-spacing: Theme.space-3;
        CardTitle { text: "Purchases by hour"; }
        Caption { text: "Busiest " + root.stats.peak-hour + " · " + root.stats.night-share + " of spending after 20:00"; }
        Bars {
            bars: root.hours;
            chart-height: 80px;
            gap: 3px;
        }
    }

    if root.stats.has-data: Tile {
        inner-spacing: Theme.space-3;
        CardTitle { text: "Week × hour"; }
        Caption { text: "Each dot is one hour; bigger means more purchases. Busiest day: " + root.stats.peak-day + "."; wrap: word-wrap; }
        DotMatrix {
            row-labels: root.week-labels;
            cells: root.heat;
            peak: root.heat-peak;
        }
    }

    if root.stats.has-data: Tile {
        inner-spacing: Theme.space-5;
        CardTitle { text: "Habits"; }
        HorizontalLayout {
            spacing: Theme.space-4;
            Figure { horizontal-stretch: 1; caption: "Entries"; value: root.stats.entries; note: root.stats.entries-per-day; }
            Figure { horizontal-stretch: 1; caption: "One purchase"; value: root.stats.gap; note: "on average between two"; }
        }
        HorizontalLayout {
            spacing: Theme.space-4;
            Figure { horizontal-stretch: 1; caption: "Average spend"; value: root.stats.avg; note: "median " + root.stats.median; }
            Figure { horizontal-stretch: 1; caption: "Costs you"; value: root.stats.work-cost; note: "of work per purchase"; }
        }
        HorizontalLayout {
            spacing: Theme.space-4;
            Figure { horizontal-stretch: 1; caption: "Weekday"; value: root.stats.weekday-avg; note: "spent per day"; }
            Figure { horizontal-stretch: 1; caption: "Weekend"; value: root.stats.weekend-avg; note: "spent per day"; }
        }
        HorizontalLayout {
            spacing: Theme.space-4;
            Figure { horizontal-stretch: 1; caption: "No-spend days"; value: root.stats.no-spend; note: root.stats.streak; }
            Figure { horizontal-stretch: 1; caption: "Income change"; value: root.stats.income-delta == "" ? "—" : (root.stats.income-up ? "+" : "−") + root.stats.income-delta; note: "vs. same length before"; }
        }
    }

    if root.insights.length > 0: Tile {
        style: TileStyle.soft;
        inner-spacing: Theme.space-3;
        HorizontalLayout {
            spacing: Theme.space-2;
            Icon { data: Icons.sparkle; y: (parent.height - self.height) / 2; }
            CardTitle { text: "Insights"; }
        }
        for i in root.insights: HorizontalLayout {
            spacing: Theme.space-3;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: i.warning ? Theme.c.negative : Theme.c.surface;
                Icon { data: i.icon; size: 16px; stroke: i.warning ? #ffffff : Theme.c.ink; }
            }
            Text {
                text: i.text;
                wrap: word-wrap;
                font-size: Type.label;
                font-weight: 500;
                color: Theme.c.ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }

    if root.categories.length > 0: Tile {
        inner-spacing: Theme.space-4;
        HorizontalLayout {
            CardTitle { text: "Categories"; horizontal-stretch: 1; }
            IconButton { icon: Icons.sliders; small: true; kind: IconButtonStyle.muted; label: "Set budgets"; clicked => { root.open-budgets(); } }
        }
        for cat in root.categories: VerticalLayout {
            spacing: Theme.space-2;
            HorizontalLayout {
                spacing: Theme.space-2;
                Icon { data: cat.icon; y: (parent.height - self.height) / 2; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text { text: cat.name; font-size: Type.label; font-weight: 600; color: Theme.c.ink; overflow: elide; }
                    Caption { text: cat.count + (cat.budget != "" ? " · " + cat.budget : ""); }
                }
                VerticalLayout {
                    Text { text: cat.amount; font-size: Type.label; font-weight: 600; color: cat.over ? Theme.c.negative : Theme.c.ink; horizontal-alignment: right; }
                    Caption { text: cat.percent; horizontal-alignment: right; }
                }
            }
            Progress {
                value: cat.budget-ratio >= 0 ? cat.budget-ratio : cat.share;
                fill: cat.over ? Theme.c.negative : cat.budget-ratio >= 0 ? Theme.c.accent : Theme.c.surface-inverse;
            }
        }
    }

    if root.largest.length > 0: Tile {
        inner-spacing: Theme.space-1;
        HorizontalLayout {
            padding-bottom: Theme.space-2;
            CardTitle { text: "Biggest purchases"; }
        }
        for tx in root.largest: ListRow {
            icon: tx.icon;
            title: tx.title;
            meta: tx.meta;
            value: tx.amount;
            value-meta: tx.time;
            clicked => { root.edit(tx.id); }
        }
    }
}
