import { Theme, Type, Icons, Motion, Glass } from "../theme.slint";
import { Tile, TileStyle, Chip, ChipScroller, Caption, CardTitle, Amount, PageTitle, PillNav, Switch,
         IconButton, IconButtonStyle, PillButton, ButtonStyle, CardHeader, Ink, Swatch, Field, ListRow } from "../components/bento.slint";

export component SettingsScreen inherits VerticalLayout {
    in property <string> currency;
    in property <int> cycle-day;
    in property <int> weekend;          // 0 Fri–Sat, 1 Sat–Sun
    in property <string> version;
    in property <string> data-note;     // "312 entries since 1 Sep 2026"
    in property <bool> can-load-demo;
    in property <int> work-hours;
    in property <bool> has-pin;
    in property <bool> has-demo;
    in property <int> repeat-count;
    in property <string> data-message;
    callback work-hours-changed(int);
    callback open-categories();
    callback open-repeats();
    callback set-pin(string /* current */, string /* new */, string /* again */) -> string;
    callback remove-pin(string) -> string;
    callback backup-now();
    callback restore-backup();
    callback export-csv();
    callback remove-demo();
    callback erase-all();
    in-out property <string> pin-error;
    property <string> pin-current;
    property <string> pin-new;
    property <string> pin-again;
    property <bool> pin-open: false;
    property <bool> confirm-erase: false;
    property <bool> confirm-restore: false;
    callback close();
    callback palette-changed(int);
    callback dark-changed(bool);
    callback cycle-day-changed(int);
    callback weekend-changed(int);
    callback currency-changed(string);
    callback load-demo();
    in property <int> style-index;      // 0 Bento, 1 Aurora Glass
    in property <bool> reduce-motion;
    in property <bool> solid-glass;
    callback style-changed(int);
    callback reduce-motion-changed(bool);
    callback solid-glass-changed(bool);

    property <[string]> currencies: ["SAR", "AED", "KWD", "QAR", "BHD", "OMR", "EGP", "JOD", "MAD", "DZD", "TND", "IQD", "USD", "EUR", "GBP"];

    spacing: Theme.gap;

    HorizontalLayout {
        spacing: Theme.space-3;
        IconButton { icon: Icons.back; label: "Back"; clicked => { root.close(); } }
        Rectangle { horizontal-stretch: 1; }
    }

    PageTitle { first: "App"; second: "Settings"; }

    Tile {
        order: 0;
        CardHeader { title: "Look"; }
        VerticalLayout {
            spacing: Theme.space-2;
            Caption { text: "Style"; }
            PillNav {
                items: ["Bento", "Aurora Glass"];
                on: TileStyle.surface;
                current: root.style-index;
                changed(i) => { root.style-changed(i); }
            }
        }
        VerticalLayout {
            spacing: Theme.space-2;
            Caption { text: "Accent"; }
            // four equal swatches, no scrolling
            HorizontalLayout {
                spacing: Theme.space-2;
                for name[i] in ["Lime", "Solar", "Ember", "Lilac"]: Swatch {
                    name: name;
                    tone: Theme.accents[i];
                    active: Theme.palette == i;
                    clicked => { root.palette-changed(i); }
                }
            }
        }
        if root.style-index == 0: VerticalLayout {
            spacing: Theme.space-2;
            Caption { text: "Mode"; }
            PillNav {
                items: ["Dark", "Light"];
                on: TileStyle.surface;
                current: Theme.dark ? 0 : 1;
                changed(i) => { root.dark-changed(i == 0); }
            }
        }
        if root.style-index == 1: Caption {
            text: "Aurora Glass is always dark: glass needs a dark, glowing background to read well.";
            wrap: word-wrap;
        }
    }

    Tile {
        order: 1;
        inner-spacing: Theme.space-4;
        CardHeader { title: "Comfort"; }
        Switch {
            text: "Reduce motion";
            note: "No springs or zooms; screens fade.";
            on: root.reduce-motion;
            toggled(v) => { root.reduce-motion-changed(v); }
        }
        if root.style-index == 1: Switch {
            text: "Solid glass";
            note: "Panels become opaque for more contrast.";
            on: root.solid-glass;
            toggled(v) => { root.solid-glass-changed(v); }
        }
    }

    Tile {
        order: 2;
        CardHeader { title: "Payday"; }
        Text {
            text: "Your budget cycle starts on this day of the month, so salary and spending land in the same cycle. Days 29 to 31 use the last day of shorter months.";
            wrap: word-wrap;
            font-size: Type.label;
            color: Ink.muted(TileStyle.surface);
        }
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: start;
            IconButton {
                icon: Icons.minus;
                kind: IconButtonStyle.muted;
                enabled: root.cycle-day > 1;
                label: "Earlier payday";
                clicked => { root.cycle-day-changed(root.cycle-day - 1); }
            }
            VerticalLayout {
                alignment: center;
                min-width: 120px;
                Text {
                    text: root.cycle-day >= 29 ? "Day " + root.cycle-day + (root.cycle-day == 31 ? " · last" : "") : "Day " + root.cycle-day;
                    font-size: Type.metric-md;
                    font-weight: 500;
                    letter-spacing: -1px;
                    color: Theme.c.ink;
                    horizontal-alignment: center;
                }
            }
            IconButton {
                icon: Icons.plus;
                kind: IconButtonStyle.muted;
                enabled: root.cycle-day < 31;
                label: "Later payday";
                clicked => { root.cycle-day-changed(root.cycle-day + 1); }
            }
        }
    }

    Tile {
        order: 3;
        CardHeader { title: "Weekend"; }
        PillNav {
            items: ["Fri – Sat", "Sat – Sun"];
            on: TileStyle.surface;
            current: root.weekend;
            changed(i) => { root.weekend-changed(i); }
        }
        Caption { text: "Used for weekday vs. weekend statistics and working hours."; wrap: word-wrap; }
    }

    Tile {
        order: 3;
        CardHeader { title: "Working hours"; }
        Text {
            text: "Paid hours in a working day. Used for “earned per hour” and what a purchase costs in work time. Only income marked “paid work” counts (Salary and Freelance by default; change it in Categories).";
            wrap: word-wrap;
            font-size: Type.label;
            color: Ink.muted(TileStyle.surface);
        }
        HorizontalLayout {
            spacing: Theme.space-3;
            alignment: start;
            IconButton {
                icon: Icons.minus;
                kind: IconButtonStyle.muted;
                enabled: root.work-hours > 1;
                label: "Fewer hours";
                clicked => { root.work-hours-changed(root.work-hours - 1); }
            }
            VerticalLayout {
                alignment: center;
                min-width: 120px;
                Text {
                    text: root.work-hours + " h a day";
                    font-size: Type.metric-md;
                    font-weight: 500;
                    letter-spacing: -1px;
                    color: Theme.c.ink;
                    horizontal-alignment: center;
                }
            }
            IconButton {
                icon: Icons.plus;
                kind: IconButtonStyle.muted;
                enabled: root.work-hours < 16;
                label: "More hours";
                clicked => { root.work-hours-changed(root.work-hours + 1); }
            }
        }
    }

    Tile {
        order: 4;
        CardHeader { title: "Currency"; }
        ChipScroller {
            for code in root.currencies: Chip {
                text: code;
                active: code == root.currency;
                on: TileStyle.surface;
                clicked => { root.currency-changed(code); }
            }
        }
        Caption {
            text: "Decimals follow the currency (KWD, BHD, OMR, JOD, TND, IQD: 3 · JPY: 0 · others: 2). Amounts are not converted to another currency; switching only changes the label and the decimals.";
            wrap: word-wrap;
        }
    }

    Tile {
        order: 5;
        inner-spacing: Theme.space-1;
        pad: Theme.space-5;
        CardHeader { title: "Manage"; }
        ListRow {
            icon: Icons.sliders;
            title: "Categories";
            meta: "Add, rename, reorder, hide or delete";
            clicked => { root.open-categories(); }
        }
        ListRow {
            icon: Icons.calendar;
            title: "Repeating entries";
            meta: root.repeat-count == 0 ? "Salary, rent, subscriptions" : root.repeat-count + (root.repeat-count == 1 ? " repeating entry" : " repeating entries");
            clicked => { root.open-repeats(); }
        }
    }

    Tile {
        order: 6;
        CardHeader { title: "App lock"; }
        Text {
            text: root.has-pin ? "A PIN is asked every time the app opens." : "Ask for a PIN when the app opens, so balances stay private.";
            wrap: word-wrap;
            font-size: Type.label;
            color: Ink.muted(TileStyle.surface);
        }
        if !root.pin-open: HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            PillButton {
                text: root.has-pin ? "Change or remove PIN" : "Set a PIN";
                kind: ButtonStyle.ghost;
                small: true;
                on: TileStyle.surface;
                clicked => { root.pin-open = true; root.pin-error = ""; }
            }
        }
        if root.pin-open: VerticalLayout {
            spacing: Theme.space-3;
            if root.has-pin: Field {
                label: "Current PIN";
                input-type: InputType.password;
                text <=> root.pin-current;
            }
            Field {
                label: "New PIN (4 to 8 digits)";
                input-type: InputType.password;
                text <=> root.pin-new;
            }
            Field {
                label: "New PIN again";
                input-type: InputType.password;
                text <=> root.pin-again;
            }
            if root.pin-error != "": Text {
                text: root.pin-error;
                font-size: Type.label;
                font-weight: 600;
                color: Theme.c.negative;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.space-2;
                PillButton {
                    text: "Cancel";
                    kind: ButtonStyle.ghost;
                    on: TileStyle.surface;
                    clicked => { root.pin-open = false; root.pin-current = ""; root.pin-new = ""; root.pin-again = ""; root.pin-error = ""; }
                }
                if root.has-pin: PillButton {
                    text: "Remove";
                    kind: ButtonStyle.danger;
                    clicked => {
                        root.pin-error = root.remove-pin(root.pin-current);
                        if root.pin-error == "" { root.pin-open = false; root.pin-current = ""; root.pin-new = ""; root.pin-again = ""; }
                    }
                }
                PillButton {
                    horizontal-stretch: 1;
                    text: "Save PIN";
                    icon: Icons.check;
                    kind: Theme.glass ? ButtonStyle.accent : ButtonStyle.inverse;
                    clicked => {
                        root.pin-error = root.set-pin(root.pin-current, root.pin-new, root.pin-again);
                        if root.pin-error == "" { root.pin-open = false; root.pin-current = ""; root.pin-new = ""; root.pin-again = ""; }
                    }
                }
            }
        }
        Caption {
            text: "The PIN keeps casual eyes out. The data file on the phone is not encrypted.";
            wrap: word-wrap;
        }
    }

    Tile {
        order: 7;
        CardHeader { title: "Your data"; }
        Text {
            text: "Everything is yours: save a copy, take it to a spreadsheet, or wipe it.";
            wrap: word-wrap;
            font-size: Type.label;
            color: Ink.muted(TileStyle.surface);
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            PillButton {
                horizontal-stretch: 1;
                text: "Back up";
                kind: ButtonStyle.ghost;
                small: true;
                on: TileStyle.surface;
                clicked => { root.confirm-restore = false; root.confirm-erase = false; root.backup-now(); }
            }
            PillButton {
                horizontal-stretch: 1;
                text: "Export CSV";
                kind: ButtonStyle.ghost;
                small: true;
                on: TileStyle.surface;
                clicked => { root.confirm-restore = false; root.confirm-erase = false; root.export-csv(); }
            }
        }
        if !root.confirm-restore: HorizontalLayout {
            alignment: start;
            PillButton {
                text: "Restore latest backup";
                kind: ButtonStyle.ghost;
                small: true;
                on: TileStyle.surface;
                clicked => { root.confirm-restore = true; root.confirm-erase = false; }
            }
        }
        if root.confirm-restore: VerticalLayout {
            spacing: Theme.space-2;
            Text {
                text: "This replaces everything now on the phone with the last backup.";
                font-size: Type.label;
                font-weight: 600;
                color: Theme.c.ink;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.space-2;
                PillButton { text: "Cancel"; kind: ButtonStyle.ghost; on: TileStyle.surface; clicked => { root.confirm-restore = false; } }
                PillButton {
                    horizontal-stretch: 1;
                    text: "Replace with backup";
                    kind: ButtonStyle.danger;
                    clicked => { root.confirm-restore = false; root.restore-backup(); }
                }
            }
        }
        if root.data-message != "": Text {
            text: root.data-message;
            font-size: Type.label;
            font-weight: 600;
            color: Theme.c.ink;
            wrap: word-wrap;
        }
        if root.has-demo: HorizontalLayout {
            alignment: start;
            PillButton {
                text: "Remove sample data";
                kind: ButtonStyle.ghost;
                small: true;
                on: TileStyle.surface;
                clicked => { root.remove-demo(); }
            }
        }
        if root.has-demo: Caption { text: "Takes out only the sample entries and accounts. Your own stay."; wrap: word-wrap; }
        if !root.confirm-erase: HorizontalLayout {
            alignment: start;
            PillButton {
                text: "Erase everything…";
                icon: Icons.trash;
                kind: ButtonStyle.danger;
                small: true;
                clicked => { root.confirm-erase = true; root.confirm-restore = false; }
            }
        }
        if root.confirm-erase: VerticalLayout {
            spacing: Theme.space-2;
            Text {
                text: "Deletes all accounts, entries, categories, budgets and the PIN from this phone. Back up first if you may want them again.";
                font-size: Type.label;
                font-weight: 600;
                color: Theme.c.negative;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.space-2;
                PillButton { text: "Cancel"; kind: ButtonStyle.ghost; on: TileStyle.surface; clicked => { root.confirm-erase = false; } }
                PillButton {
                    horizontal-stretch: 1;
                    text: "Erase everything";
                    icon: Icons.trash;
                    kind: ButtonStyle.danger;
                    clicked => { root.confirm-erase = false; root.erase-all(); }
                }
            }
        }
    }

    Tile {
        style: TileStyle.soft;
        inner-spacing: Theme.space-2;
        order: 8;
        CardHeader { title: "Private by design"; on: TileStyle.soft; }
        Text {
            text: "Everything stays in a database on this phone. No account, no internet permission, no ads.";
            wrap: word-wrap;
            font-size: Type.label;
            color: Ink.muted(TileStyle.soft);
        }
        if root.data-note != "": Caption { text: root.data-note; on: TileStyle.soft; }
        if root.can-load-demo: HorizontalLayout {
            alignment: start;
            padding-top: Theme.space-2;
            PillButton {
                text: "Load sample data";
                kind: ButtonStyle.ghost;
                small: true;
                clicked => { root.load-demo(); }
            }
        }
        Caption { text: "Income Radar " + root.version; on: TileStyle.soft; }
    }
}
