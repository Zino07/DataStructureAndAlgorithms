import { Theme, Type, Icons } from "../theme.slint";
import { Tile, TileStyle, PillNav, ListRow, Caption, Amount, PageTitle, IconButton, IconButtonStyle,
         Field, Ink } from "../components/bento.slint";

// One figure of the compact summary.
component Sum inherits VerticalLayout {
    in property <string> caption;
    in property <string> value;
    in property <color> color: Ink.fg(TileStyle.inverse);
    horizontal-stretch: 1;
    preferred-width: 1px;
    spacing: 2px;
    Caption { text: root.caption; on: TileStyle.inverse; }
    Text {
        text: root.value;
        font-size: Type.body + 1px;
        font-weight: 600;
        letter-spacing: -0.2px;
        color: root.color;
        overflow: elide;
    }
}
import { Dashboard, TxRow } from "../data.slint";

export component ActivityScreen inherits VerticalLayout {
    in property <Dashboard> dash;
    in property <[TxRow]> rows;
    in property <string> result-note;  // "84 entries · 2,140.00 spent"
    in-out property <int> filter: 0;   // 0 all, 1 expenses, 2 income, 3 transfers
    in-out property <string> query;
    in-out property <int> selected: -1; // selected transfer id
    callback filter-changed(int);
    callback query-changed(string);
    callback edit(int);
    callback delete-transfer(int);

    spacing: Theme.gap;

    PageTitle { first: "Your"; second: "Activity"; }

    Field {
        placeholder: "Search notes, categories, accounts";
        icon: Icons.search;
        on: TileStyle.muted;
        text <=> root.query;
        edited(t) => { root.query-changed(t); }
    }

    PillNav {
        items: ["All", "Spent", "Income", "Transfers"];
        current <=> root.filter;
        changed(i) => {
            root.selected = -1;
            root.filter-changed(i);
        }
    }

    // compact summary of the cycle: received, spent and what is left
    if root.filter != 3: Tile {
        style: TileStyle.inverse;
        pad: Theme.space-4;
        inner-spacing: Theme.space-2;
        order: 0;
        Caption { text: root.dash.cycle; on: TileStyle.inverse; }
        HorizontalLayout {
            spacing: Theme.space-3;
            Sum { caption: "Received"; value: "+" + root.dash.income; }
            Sum { caption: "Spent"; value: "−" + root.dash.expense; }
            Sum {
                caption: "Net";
                value: (root.dash.net-negative ? "−" : "+") + root.dash.net;
                color: root.dash.net-negative ? Theme.c.negative : Theme.glass ? Theme.c.accent : Ink.fg(TileStyle.inverse);
            }
        }
    }

    Tile {
        inner-spacing: 2px;
        pad: Theme.space-5;
        order: 1;
        if root.result-note != "": Caption { text: root.result-note; height: 20px; }
        if root.rows.length == 0: VerticalLayout {
            padding-top: Theme.space-4;
            padding-bottom: Theme.space-4;
            Text {
                text: root.query != "" ? "No entries match “" + root.query + "”." : "Nothing here yet.";
                font-size: Type.body;
                color: Theme.c.ink-muted;
                wrap: word-wrap;
            }
        }
        for row in root.rows: VerticalLayout {
            // day header with what was spent and received that day
            if row.header: HorizontalLayout {
                height: 36px;
                spacing: Theme.space-2;
                padding-bottom: 2px;
                Caption {
                    text: row.title;
                    vertical-alignment: bottom;
                    font-weight: 700;
                    color: Theme.c.ink;
                    horizontal-stretch: 1;
                }
                if row.meta != "": Caption {
                    text: row.meta;
                    vertical-alignment: bottom;
                    font-weight: 600;
                    color: Theme.c.positive;
                }
                if row.amount != "": Caption {
                    text: row.amount;
                    vertical-alignment: bottom;
                    font-weight: 600;
                }
            }
            if !row.header: ListRow {
                icon: row.icon;
                title: row.title;
                meta: row.meta;
                value: row.transfer && root.selected == row.id ? "" : row.amount;
                value-meta: row.time;
                positive: row.income;
                selected: row.transfer && root.selected == row.id;
                clicked => {
                    if row.transfer {
                        root.selected = root.selected == row.id ? -1 : row.id;
                    } else {
                        root.edit(row.id);
                    }
                }
                if row.transfer && root.selected == row.id: IconButton {
                    icon: Icons.trash;
                    small: true;
                    kind: IconButtonStyle.inverse;
                    label: "Delete transfer";
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.delete-transfer(row.id);
                        root.selected = -1;
                    }
                }
            }
        }
    }
}
