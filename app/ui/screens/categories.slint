import { Theme, Type, Icons } from "../theme.slint";
import { Tile, TileStyle, Chip, Caption, PageTitle, PillNav, PillButton, ButtonStyle, Field, ListRow,
         IconButton, IconButtonStyle, CardHeader, Icon, Switch, Ink } from "../components/bento.slint";
import { CatRow, IconChoice } from "../data.slint";

// One icon in the picker.
component IconCell inherits Rectangle {
    in property <string> path;
    in property <bool> active;
    in property <string> label;
    callback clicked;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }
    height: 44px;
    border-radius: 14px;
    background: root.active ? Theme.c.accent : Theme.c.surface-muted;
    Icon { data: root.path; stroke: root.active ? Theme.c.on-accent : Theme.c.ink; }
    TouchArea { clicked => { root.clicked(); } }
}

export component CategoriesScreen inherits VerticalLayout {
    in property <[CatRow]> expense;
    in property <[CatRow]> income;
    in property <[IconChoice]> icons;
    in-out property <string> error;
    callback close();
    callback add(string /* name */, int /* kind 0/1 */, string /* icon key */, bool /* work */) -> string;
    callback update(int, string, string, bool) -> string;
    callback hide(int, bool) -> string;
    callback move(int, bool /* up */);
    // move-to < 0: delete the entries too
    callback remove(int, int /* move entries to */) -> string;

    in-out property <int> kind: 0;
    // -1: nothing open, -2: new category, otherwise the id being edited
    in-out property <int> selected: -1;
    property <string> name;
    property <string> icon-key: "tag";
    property <bool> work: false;
    property <bool> confirm-delete: false;
    property <[CatRow]> rows: root.kind == 0 ? root.expense : root.income;
    property <CatRow> current: {
        id: -1, name: "", icon: "", icon-key: "", uses: 0, hidden: false, work: false,
        income: false, has-budget: false, first: false, last: false
    };

    function open(r: CatRow) {
        root.error = "";
        root.confirm-delete = false;
        if root.selected == r.id {
            root.selected = -1;
        } else {
            root.selected = r.id;
            root.name = r.name;
            root.icon-key = r.icon-key;
            root.work = r.work;
            root.current = r;
        }
    }

    function open-new() {
        root.error = "";
        root.confirm-delete = false;
        root.selected = -2;
        root.name = "";
        root.icon-key = "tag";
        root.work = root.kind == 1;
    }

    spacing: Theme.gap;

    HorizontalLayout {
        spacing: Theme.space-3;
        IconButton { icon: Icons.back; label: "Back"; clicked => { root.close(); } }
        Rectangle { horizontal-stretch: 1; }
    }

    PageTitle { first: "Your"; second: "Categories"; }

    PillNav {
        items: ["Spending", "Income"];
        current: root.kind;
        changed(i) => {
            root.kind = i;
            root.selected = -1;
            root.confirm-delete = false;
            root.error = "";
        }
    }

    Tile {
        inner-spacing: Theme.space-1;
        pad: Theme.space-5;
        order: 0;
        CardHeader { title: root.kind == 0 ? "Spending categories" : "Income categories"; }
        for r in root.rows: ListRow {
            icon: r.icon;
            title: r.name;
            meta: (r.hidden ? "Hidden · " : "") + r.uses + (r.uses == 1 ? " entry" : " entries")
                + (r.has-budget ? " · budget" : "") + (r.work ? " · paid work" : "");
            selected: root.selected == r.id;
            clicked => { root.open(r); }
        }
        if root.error != "" && root.selected == -1: Text {
            text: root.error;
            font-size: Type.label;
            font-weight: 600;
            color: Theme.c.negative;
            wrap: word-wrap;
        }
        if root.selected == -1: HorizontalLayout {
            padding-top: Theme.space-2;
            alignment: start;
            PillButton {
                text: "New category";
                icon: Icons.plus;
                kind: ButtonStyle.ghost;
                small: true;
                on: TileStyle.surface;
                clicked => { root.open-new(); }
            }
        }
    }

    // editor for the open category, or the new one
    if root.selected != -1: Tile {
        inner-spacing: Theme.space-4;
        order: 0;
        CardHeader { title: root.selected == -2 ? "New category" : "Edit category"; }
        Field {
            label: "Name";
            placeholder: "e.g. Pets";
            text <=> root.name;
        }
        VerticalLayout {
            spacing: Theme.space-2;
            Caption { text: "Icon"; }
            GridLayout {
                spacing: Theme.space-2;
                for ic[i] in root.icons: IconCell {
                    row: floor(i / 6);
                    col: Math.mod(i, 6);
                    path: ic.path;
                    label: ic.key;
                    active: ic.key == root.icon-key;
                    clicked => { root.icon-key = ic.key; }
                }
            }
        }
        if root.kind == 1: Switch {
            text: "Counts as paid work";
            note: "Used for “earned per hour”. Turn off for gifts or investments.";
            on: root.work;
            toggled(v) => { root.work = v; }
        }
        if root.error != "": Text {
            text: root.error;
            font-size: Type.label;
            font-weight: 600;
            color: Theme.c.negative;
            wrap: word-wrap;
        }

        if !root.confirm-delete: VerticalLayout {
            spacing: Theme.space-3;
            HorizontalLayout {
                spacing: Theme.space-2;
                PillButton {
                    text: "Cancel";
                    kind: ButtonStyle.ghost;
                    on: TileStyle.surface;
                    clicked => { root.selected = -1; root.error = ""; }
                }
                PillButton {
                    horizontal-stretch: 1;
                    text: root.selected == -2 ? "Add category" : "Save";
                    icon: root.selected == -2 ? Icons.plus : Icons.check;
                    kind: Theme.glass ? ButtonStyle.accent : ButtonStyle.inverse;
                    clicked => {
                        if root.selected == -2 {
                            root.error = root.add(root.name, root.kind, root.icon-key, root.work);
                        } else {
                            root.error = root.update(root.selected, root.name, root.icon-key, root.work);
                        }
                        if root.error == "" { root.selected = -1; }
                    }
                }
            }
            if root.selected >= 0: HorizontalLayout {
                spacing: Theme.space-2;
                IconButton {
                    icon: Icons.arrow-up;
                    kind: IconButtonStyle.muted;
                    label: "Move up";
                    enabled: !root.current.first;
                    clicked => { root.move(root.selected, true); root.selected = -1; }
                }
                IconButton {
                    icon: Icons.arrow-down;
                    kind: IconButtonStyle.muted;
                    label: "Move down";
                    enabled: !root.current.last;
                    clicked => { root.move(root.selected, false); root.selected = -1; }
                }
                PillButton {
                    horizontal-stretch: 1;
                    text: root.current.hidden ? "Show again" : "Hide";
                    kind: ButtonStyle.ghost;
                    on: TileStyle.surface;
                    clicked => {
                        root.error = root.hide(root.selected, !root.current.hidden);
                        if root.error == "" { root.selected = -1; }
                    }
                }
                PillButton {
                    text: "Delete";
                    icon: Icons.trash;
                    kind: ButtonStyle.danger;
                    clicked => {
                        root.error = "";
                        if root.current.uses == 0 {
                            root.error = root.remove(root.selected, -1);
                            if root.error == "" { root.selected = -1; }
                        } else {
                            root.confirm-delete = true;
                        }
                    }
                }
            }
            if root.selected >= 0: Caption {
                text: "Hiding keeps the history and removes it from the pickers.";
                wrap: word-wrap;
            }
        }

        // entries use it: move them or delete them with it
        if root.confirm-delete && root.selected >= 0: VerticalLayout {
            spacing: Theme.space-3;
            Text {
                text: root.current.uses + (root.current.uses == 1 ? " entry uses" : " entries use") + " “" + root.current.name + "”. Move them to:";
                font-size: Type.label + 1px;
                font-weight: 600;
                color: Theme.c.ink;
                wrap: word-wrap;
            }
            Flickable {
                height: Theme.control-md;
                content-width: move-row.preferred-width;
                move-row := HorizontalLayout {
                    spacing: Theme.space-2;
                    for r in root.rows: HorizontalLayout {
                        if r.id != root.selected && !r.hidden: Chip {
                            text: r.name;
                            accessible-label: "Move entries to " + r.name;
                            icon: r.icon;
                            on: TileStyle.surface;
                            clicked => {
                                root.error = root.remove(root.selected, r.id);
                                root.confirm-delete = false;
                                if root.error == "" { root.selected = -1; }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-2;
                PillButton {
                    text: "Cancel";
                    kind: ButtonStyle.ghost;
                    on: TileStyle.surface;
                    clicked => { root.confirm-delete = false; }
                }
                PillButton {
                    horizontal-stretch: 1;
                    text: "Delete the entries too";
                    icon: Icons.trash;
                    kind: ButtonStyle.danger;
                    clicked => {
                        root.error = root.remove(root.selected, -1);
                        root.confirm-delete = false;
                        if root.error == "" { root.selected = -1; }
                    }
                }
            }
        }
    }
}
