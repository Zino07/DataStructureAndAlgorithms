import { Theme, Type, Icons } from "../theme.slint";
import { Tile, TileStyle, NotchCard, IconButton, IconButtonStyle, Chip, Badge, Progress, Bars, Amount,
         ListRow, Caption, CardTitle, PageTitle, Icon, PillButton, ButtonStyle, CardHeader, Ink, Morph } from "../components/bento.slint";
import { Dashboard, Bar, TxRow, CategoryShare } from "../data.slint";

export component HomeScreen inherits VerticalLayout {
    in property <Dashboard> dash;
    in property <[Bar]> week;
    in property <[TxRow]> recent;
    in property <[CategoryShare]> top-categories;
    callback add();
    callback edit(int);
    callback open-activity();
    callback open-accounts();
    callback open-stats();
    callback open-settings();
    callback load-demo();

    spacing: Theme.gap;

    // header
    HorizontalLayout {
        spacing: Theme.space-2;
        Rectangle {
            width: Theme.control-lg;
            height: Theme.control-lg;
            border-radius: self.width / 2;
            background: Theme.glass ? Theme.c.accent : Theme.c.surface-inverse;
            drop-shadow-blur: Theme.glass ? 18px : 0px;
            drop-shadow-color: Theme.c.accent.with-alpha(0.4);
            Icon { data: Icons.radar; stroke: Theme.glass ? Theme.c.on-accent : Theme.c.ink-inverse; }
        }
        Rectangle { horizontal-stretch: 1; }
        Rectangle {
            height: Theme.control-lg;
            width: date-row.preferred-width;
            border-radius: self.height / 2;
            background: Theme.c.surface;
            border-width: Theme.glass ? 1px : 0px;
            border-color: #ffffff14;
            date-row := HorizontalLayout {
                padding-left: Theme.space-4;
                padding-right: Theme.space-5;
                spacing: Theme.space-2;
                alignment: center;
                Icon { data: Icons.calendar; y: (parent.height - self.height) / 2; }
                Text {
                    text: root.dash.today;
                    font-size: Type.label;
                    font-weight: 600;
                    color: Theme.c.ink;
                    vertical-alignment: center;
                }
            }
        }
        IconButton {
            icon: Icons.sliders;
            label: "Settings";
            clicked => { root.open-settings(); }
        }
    }

    VerticalLayout {
        padding-top: Theme.space-2;
        spacing: Theme.space-3;
        PageTitle { first: "Income"; second: "Radar"; }
        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;
            Chip { text: root.dash.cycle; active: true; clicked => { root.open-stats(); } }
            Chip { text: root.dash.days-left; outline: true; clicked => { root.open-stats(); } }
        }
    }

    // hero: total balance and the last seven days of spending
    Tile {
        style: TileStyle.inverse;
        inner-spacing: Theme.space-5;
        order: 0;
        HorizontalLayout {
            spacing: Theme.space-3;
            VerticalLayout {
                spacing: Theme.space-1;
                horizontal-stretch: 1;
                Caption { text: "Total balance"; on: TileStyle.inverse; }
                Amount { value: root.dash.balance; unit: root.dash.currency; size: Type.metric-xl; on: TileStyle.inverse; }
            }
            IconButton {
                icon: Icons.arrow-up-right;
                kind: Theme.glass ? IconButtonStyle.muted : IconButtonStyle.surface;
                label: "Open accounts";
                clicked => { root.open-accounts(); }
            }
        }
        if root.dash.has-entries: VerticalLayout {
            spacing: Theme.space-3;
            HorizontalLayout {
                Caption { text: "Last 7 days"; on: TileStyle.inverse; horizontal-stretch: 1; }
                Caption { text: root.dash.week-total + " spent"; on: TileStyle.inverse; horizontal-alignment: right; }
            }
            Bars {
                bars: root.week;
                chart-height: 84px;
                base: Ink.strong(TileStyle.inverse);
                track: Ink.track(TileStyle.inverse);
                tip-bg: Theme.glass ? #ffffff26 : Theme.c.surface;
                label-color: Ink.muted(TileStyle.inverse);
            }
        }
        if !root.dash.has-entries: VerticalLayout {
            spacing: Theme.space-4;
            Text {
                text: "Log what you earn and spend.\nThe radar shows how much you can spend each day.";
                wrap: word-wrap;
                font-size: Type.body;
                color: Ink.muted(TileStyle.inverse);
            }
            HorizontalLayout {
                alignment: start;
                PillButton {
                    text: "Add first entry";
                    icon: Icons.plus;
                    kind: ButtonStyle.accent;
                    clicked => {
                        Morph.from(self.absolute-position.x, self.absolute-position.y, self.width, self.height, self.height / 2, Theme.c.accent);
                        root.add();
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                PillButton { text: "Or try sample data"; kind: ButtonStyle.ghost; small: true; on: TileStyle.inverse; clicked => { root.load-demo(); } }
            }
        }
    }

    // today: what is left of the daily allowance
    NotchCard {
        style: TileStyle.accent;
        icon: Icons.plus;
        label: "Add entry";
        button-kind: Theme.glass ? IconButtonStyle.accent : IconButtonStyle.inverse;
        order: 1;
        action => { root.add(); }
        HorizontalLayout {
            spacing: Theme.space-2;
            Caption { text: root.dash.today-over ? "Over today's budget" : "Left to spend today"; on: TileStyle.accent; }
            if root.dash.today-over: Icon { data: Icons.alert; size: 14px; stroke: Ink.fg(TileStyle.accent); }
        }
        Amount {
            value: (root.dash.today-over ? "−" : "") + root.dash.today-left;
            unit: root.dash.currency;
            size: Type.metric-md + 4px;
            on: TileStyle.accent;
        }
        Progress {
            value: root.dash.today-ratio;
            track: Ink.track(TileStyle.accent);
            fill: Theme.glass ? Theme.c.accent : Theme.c.on-accent;
        }
        Caption {
            text: root.dash.has-income || root.dash.has-entries
                ? "Daily budget " + root.dash.allowance + " · spent " + root.dash.spent-today
                : "Add income to set your daily budget";
            on: TileStyle.accent;
        }
    }

    if root.dash.has-entries: HorizontalLayout {
        spacing: Theme.gap;
        Tile {
            horizontal-stretch: 1;
            pad: Theme.space-5;
            inner-spacing: Theme.space-3;
            order: 2;
            CardHeader {
                title: "Income";
                badge: root.dash.income-delta;
                badge-up: root.dash.income-up;
            }
            Rectangle { vertical-stretch: 1; }
            Amount { value: root.dash.income; size: Type.metric-sm; fit-chars: Math.max(root.dash.income.character-count, root.dash.expense.character-count); }
            Caption { text: "this cycle"; }
        }
        Tile {
            horizontal-stretch: 1;
            pad: Theme.space-5;
            inner-spacing: Theme.space-3;
            order: 2;
            CardHeader {
                title: "Spent";
                badge: root.dash.expense-delta;
                badge-up: root.dash.expense-up;
                badge-bad: root.dash.expense-up;
            }
            Rectangle { vertical-stretch: 1; }
            Amount { value: root.dash.expense; size: Type.metric-sm; fit-chars: Math.max(root.dash.income.character-count, root.dash.expense.character-count); }
            // the line marks how much of the cycle has passed
            Progress { value: root.dash.spent-ratio; fill: Ink.strong(TileStyle.surface); marker: root.dash.pace-ratio; }
        }
    }

    if root.dash.has-entries: HorizontalLayout {
        spacing: Theme.gap;
        Tile {
            horizontal-stretch: 1;
            style: TileStyle.soft;
            pad: Theme.space-5;
            inner-spacing: Theme.space-3;
            order: 3;
            CardHeader { title: "Saved"; on: TileStyle.soft; }
            Rectangle { vertical-stretch: 1; }
            Amount { value: root.dash.savings-rate; size: Type.metric-md; on: TileStyle.soft; }
            Progress { value: root.dash.savings-ratio; track: Ink.track(TileStyle.soft); fill: Theme.glass ? Theme.c.accent : Theme.c.surface-inverse; }
            Caption { text: "of this cycle's income"; on: TileStyle.soft; }
        }
        Tile {
            horizontal-stretch: 1;
            pad: Theme.space-5;
            inner-spacing: Theme.space-3;
            order: 3;
            CardHeader {
                title: "On pace";
                action-icon: Icons.arrow-up-right;
                action-label: "Open statistics";
                action => { root.open-stats(); }
            }
            Rectangle { vertical-stretch: 1; }
            Amount { value: root.dash.projected; size: Type.metric-sm; }
            Caption { text: "spent by cycle end"; }
        }
    }

    if root.top-categories.length > 0: Tile {
        order: 4;
        CardHeader {
            title: "Where it goes";
            action-icon: Icons.arrow-up-right;
            action-label: "Category statistics";
            action => { root.open-stats(); }
        }
        for cat in root.top-categories: VerticalLayout {
            spacing: Theme.space-2;
            HorizontalLayout {
                spacing: Theme.space-2;
                Icon { data: cat.icon; y: (parent.height - self.height) / 2; }
                Text {
                    text: cat.name;
                    font-size: Type.label;
                    font-weight: 600;
                    color: Theme.c.ink;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if cat.over: Badge { text: "Over budget"; up: true; bad: true; y: (parent.height - self.height) / 2; }
                Text {
                    text: cat.percent;
                    font-size: Type.label;
                    font-weight: 500;
                    color: Theme.c.ink-muted;
                    vertical-alignment: center;
                }
                Text {
                    text: cat.amount;
                    font-size: Type.label;
                    font-weight: 600;
                    color: Theme.c.ink;
                    vertical-alignment: center;
                    min-width: 84px;
                    horizontal-alignment: right;
                }
            }
            Progress {
                value: cat.budget-ratio >= 0 ? cat.budget-ratio : cat.share;
                fill: cat.over ? Theme.c.negative : Ink.strong(TileStyle.surface);
            }
        }
    }

    if root.dash.has-entries: Tile {
        inner-spacing: Theme.space-1;
        order: 5;
        CardHeader {
            title: "Recent";
            action-icon: Icons.arrow-up-right;
            action-label: "Open activity";
            action => { root.open-activity(); }
        }
        Rectangle { height: Theme.space-1; }
        if root.recent.length == 0: Text {
            text: "Nothing logged yet.";
            font-size: Type.body;
            color: Theme.c.ink-muted;
        }
        for tx in root.recent: ListRow {
            icon: tx.icon;
            title: tx.title;
            meta: tx.meta;
            value: tx.amount;
            value-meta: tx.time;
            positive: tx.income;
            clicked => { root.edit(tx.id); }
        }
    }
}
