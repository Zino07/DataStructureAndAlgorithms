import { Theme, Type, Icons } from "../theme.slint";
import { Tile, TileStyle, Chip, ChipScroller, Caption, CardTitle, Amount, PageTitle, PillButton, ButtonStyle,
         Field, ListRow, IconButton, IconButtonStyle, CardHeader, Progress, Ink, Morph } from "../components/bento.slint";
import { Dashboard, AccountItem } from "../data.slint";

export component AccountsScreen inherits VerticalLayout {
    in property <Dashboard> dash;
    in property <[AccountItem]> accounts;
    in-out property <string> error;
    // returns "" on success, otherwise an error message
    callback add-account(string /* name */, int /* kind */, string /* opening */) -> string;
    callback update-account(int /* id */, string /* name */, int /* kind */, string /* opening */) -> string;
    // move-to < 0: delete the entries too
    callback delete-account(int /* id */, int /* move entries to */) -> string;
    callback transfer();

    property <string> name;
    property <int> kind: 1;
    property <string> opening;
    property <int> selected: -1;
    in-out property <bool> adding: false;
    property <string> edit-name;
    property <int> edit-kind;
    property <string> edit-opening;
    property <bool> confirm-delete: false;
    property <AccountItem> current: { id: -1, name: "", kind: "", icon: "", balance: "", negative: false, share: 0, percent: "", kind-index: 0, opening: "", entries: 0 };

    spacing: Theme.gap;

    PageTitle { first: "Your"; second: "Accounts"; }

    Tile {
        style: TileStyle.inverse;
        inner-spacing: Theme.space-2;
        order: 0;
        Caption { text: "Total balance"; on: TileStyle.inverse; }
        Amount { value: root.dash.balance; unit: root.dash.currency; size: Type.metric-xl; on: TileStyle.inverse; }
        HorizontalLayout {
            padding-top: Theme.space-2;
            Caption {
                text: root.accounts.length + (root.accounts.length == 1 ? " account" : " accounts");
                on: TileStyle.inverse;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            PillButton {
                text: "Move money";
                icon: Icons.swap;
                small: true;
                kind: ButtonStyle.accent;
                enabled: root.accounts.length > 1;
                clicked => {
                    Morph.from(self.absolute-position.x, self.absolute-position.y, self.width, self.height, self.height / 2, Theme.c.accent);
                    root.transfer();
                }
            }
        }
    }

    Tile {
        inner-spacing: Theme.space-1;
        pad: Theme.space-5;
        order: 1;
        CardHeader { title: "Accounts"; }
        for acc in root.accounts: VerticalLayout {
            spacing: 0px;
            ListRow {
                icon: acc.icon;
                title: acc.name;
                meta: acc.kind + (acc.percent != "" ? " · " + acc.percent + " of total" : "");
                value: root.selected == acc.id ? "" : acc.balance;
                negative: acc.negative;
                selected: root.selected == acc.id;
                clicked => {
                    root.error = "";
                    root.confirm-delete = false;
                    root.adding = false;
                    if root.selected == acc.id {
                        root.selected = -1;
                    } else {
                        root.selected = acc.id;
                        root.edit-name = acc.name;
                        root.edit-kind = acc.kind-index;
                        root.edit-opening = acc.opening;
                        root.current = acc;
                    }
                }
            }
            // share of everything you have, under the name
            HorizontalLayout {
                padding-left: 52px;
                padding-bottom: Theme.space-2;
                Progress {
                    value: acc.share;
                    thickness: 4px;
                    fill: acc.negative ? Theme.c.negative : Theme.glass ? Theme.c.accent : Ink.strong(TileStyle.surface);
                }
            }
        }
        if root.error != "" && !root.adding && root.selected < 0: Text {
            text: root.error;
            font-size: Type.label;
            font-weight: 600;
            color: Theme.c.negative;
            wrap: word-wrap;
        }
        if !root.adding: HorizontalLayout {
            padding-top: Theme.space-2;
            alignment: start;
            PillButton {
                text: "New account";
                icon: Icons.plus;
                kind: ButtonStyle.ghost;
                small: true;
                on: TileStyle.surface;
                clicked => {
                    root.adding = true;
                    root.selected = -1;
                    root.error = "";
                }
            }
        }
    }

    // edit or delete the open account
    if root.selected >= 0 && !root.adding: Tile {
        inner-spacing: Theme.space-4;
        order: 0;
        CardHeader { title: "Edit account"; }
        Field {
            label: "Name";
            text <=> root.edit-name;
        }
        VerticalLayout {
            spacing: Theme.space-2;
            Caption { text: "Type"; }
            HorizontalLayout {
                spacing: Theme.space-2;
                for t[i] in ["Cash", "Bank", "Card", "Savings"]: Chip {
                    horizontal-stretch: 1;
                    text: t;
                    on: TileStyle.surface;
                    active: root.edit-kind == i;
                    clicked => { root.edit-kind = i; }
                }
            }
        }
        Field {
            label: "Opening balance (" + root.dash.currency + ")";
            placeholder: "0";
            input-type: InputType.decimal;
            text <=> root.edit-opening;
        }
        Caption {
            text: "The opening balance is what the account held before your first entry. Fix it here if the balance is off.";
            wrap: word-wrap;
        }
        if root.error != "": Text {
            text: root.error;
            font-size: Type.label;
            font-weight: 600;
            color: Theme.c.negative;
            wrap: word-wrap;
        }
        if !root.confirm-delete: HorizontalLayout {
            spacing: Theme.space-2;
            PillButton {
                text: "Cancel";
                kind: ButtonStyle.ghost;
                on: TileStyle.surface;
                clicked => { root.selected = -1; root.error = ""; }
            }
            PillButton {
                icon: Icons.trash;
                text: "Delete";
                kind: ButtonStyle.danger;
                enabled: root.accounts.length > 1;
                clicked => {
                    root.error = "";
                    if root.current.entries == 0 {
                        root.error = root.delete-account(root.selected, -1);
                        if root.error == "" { root.selected = -1; }
                    } else {
                        root.confirm-delete = true;
                    }
                }
            }
            PillButton {
                horizontal-stretch: 1;
                text: "Save";
                icon: Icons.check;
                kind: Theme.glass ? ButtonStyle.accent : ButtonStyle.inverse;
                clicked => {
                    root.error = root.update-account(root.selected, root.edit-name, root.edit-kind, root.edit-opening);
                    if root.error == "" { root.selected = -1; }
                }
            }
        }
        if root.accounts.length <= 1 && !root.confirm-delete: Caption { text: "Keep at least one account."; }
        if root.confirm-delete: VerticalLayout {
            spacing: Theme.space-3;
            Text {
                text: root.current.entries + (root.current.entries == 1 ? " entry or transfer uses" : " entries and transfers use") + " “" + root.current.name + "”. Move them (and its balance) to:";
                font-size: Type.label + 1px;
                font-weight: 600;
                color: Theme.c.ink;
                wrap: word-wrap;
            }
            Flickable {
                height: Theme.control-md;
                content-width: move-row.preferred-width;
                move-row := HorizontalLayout {
                    spacing: Theme.space-2;
                    for other in root.accounts: HorizontalLayout {
                        if other.id != root.selected: Chip {
                            text: other.name;
                            accessible-label: "Move to " + other.name;
                            icon: other.icon;
                            on: TileStyle.surface;
                            clicked => {
                                root.error = root.delete-account(root.selected, other.id);
                                root.confirm-delete = false;
                                if root.error == "" { root.selected = -1; }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.space-2;
                PillButton {
                    text: "Cancel";
                    kind: ButtonStyle.ghost;
                    on: TileStyle.surface;
                    clicked => { root.confirm-delete = false; }
                }
                PillButton {
                    horizontal-stretch: 1;
                    text: "Delete everything in it";
                    icon: Icons.trash;
                    kind: ButtonStyle.danger;
                    clicked => {
                        root.error = root.delete-account(root.selected, -1);
                        root.confirm-delete = false;
                        if root.error == "" { root.selected = -1; }
                    }
                }
            }
        }
    }

    // the form only shows once asked for
    if root.adding: Tile {
        inner-spacing: Theme.space-4;
        order: 0;
        CardHeader { title: "New account"; }
        Field {
            label: "Name";
            placeholder: "e.g. Main bank, Wallet";
            text <=> root.name;
        }
        VerticalLayout {
            spacing: Theme.space-2;
            Caption { text: "Type"; }
            HorizontalLayout {
                spacing: Theme.space-2;
                for t[i] in ["Cash", "Bank", "Card", "Savings"]: Chip {
                    horizontal-stretch: 1;
                    text: t;
                    on: TileStyle.surface;
                    active: root.kind == i;
                    clicked => { root.kind = i; }
                }
            }
        }
        Field {
            label: "Opening balance (" + root.dash.currency + ")";
            placeholder: "0.00";
            input-type: InputType.decimal;
            text <=> root.opening;
        }
        if root.error != "": Text {
            text: root.error;
            font-size: Type.label;
            font-weight: 600;
            color: Theme.c.negative;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.space-2;
            PillButton {
                text: "Cancel";
                kind: ButtonStyle.ghost;
                on: TileStyle.surface;
                clicked => {
                    root.adding = false;
                    root.error = "";
                }
            }
            PillButton {
                horizontal-stretch: 1;
                text: "Add account";
                icon: Icons.plus;
                kind: Theme.glass ? ButtonStyle.accent : ButtonStyle.inverse;
                clicked => {
                    root.error = root.add-account(root.name, root.kind, root.opening);
                    if root.error == "" {
                        root.name = "";
                        root.opening = "";
                        root.adding = false;
                    }
                }
            }
        }
    }
}
