// Bento Neo components: tiles, notch card, pills, icon buttons, chips, badges,
// progress, pill bars, dot matrix, list rows, segmented nav, glass dock.
// Every component also renders the Aurora Glass style (Theme.glass).

import { Theme, Type, Icons, Glass, Motion } from "../theme.slint";

// Where the next morph transition starts: the window rectangle of the control
// that was tapped. Whoever opens a morphing page sets it first.
export global Morph {
    in-out property <length> x: 0px;
    in-out property <length> y: 0px;
    in-out property <length> w: 0px;
    in-out property <length> h: 0px;
    in-out property <length> r: 0px;
    in-out property <color> fill: transparent;
    public function from(x: length, y: length, w: length, h: length, r: length, fill: color) {
        self.x = x;
        self.y = y;
        self.w = w;
        self.h = h;
        self.r = r;
        self.fill = fill;
    }
}

export enum TileStyle { surface, inverse, accent, soft, muted }
export enum ButtonStyle { inverse, accent, ghost, danger }
export enum IconButtonStyle { surface, inverse, accent, muted, outline, glass }

export struct Bar {
    value: float,      // 0..1 of the chart scale
    label: string,     // axis label ("" hides it)
    tip: string,       // value bubble text for the highlighted bar
    highlight: bool,
    empty: bool,
    over: bool,        // taller than the capped scale: drawn full height with a mark
}

export component Icon inherits Path {
    in property <string> data;
    in property <length> size: 18px;
    commands: data;
    viewbox-width: 24;
    viewbox-height: 24;
    width: size;
    height: size;
    fill: transparent;
    stroke: Theme.c.ink;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// Colours for content that sits on a given tile style.
export global Ink {
    public pure function fg(style: TileStyle) -> color {
        if Theme.glass { return Theme.c.ink; }
        if style == TileStyle.inverse { return Theme.c.ink-inverse; }
        if style == TileStyle.accent { return Theme.c.on-accent; }
        return Theme.c.ink;
    }
    public pure function muted(style: TileStyle) -> color {
        if Theme.glass { return Theme.c.ink-muted; }
        if style == TileStyle.inverse { return Theme.c.ink-inverse.with-alpha(0.64); }
        if style == TileStyle.accent { return Theme.c.on-accent.with-alpha(0.7); }
        return Theme.c.ink-muted;
    }
    public pure function bg(style: TileStyle) -> color {
        if Theme.glass { return transparent; }
        if style == TileStyle.inverse { return Theme.c.surface-inverse; }
        if style == TileStyle.accent { return Theme.c.accent; }
        if style == TileStyle.soft { return Theme.c.accent-soft; }
        if style == TileStyle.muted { return Theme.c.surface-muted; }
        return Theme.c.surface;
    }
    // A fill that stays visible on top of the given tile.
    public pure function raised(style: TileStyle) -> color {
        if Theme.glass { return #ffffff14; }
        if style == TileStyle.inverse { return Theme.c.ink-inverse.with-alpha(0.12); }
        if style == TileStyle.accent { return Theme.c.on-accent.with-alpha(0.10); }
        if style == TileStyle.soft { return Theme.c.surface; }
        return Theme.c.surface-muted;
    }
    // A faint track for charts and progress on the given tile.
    public pure function track(style: TileStyle) -> color {
        if Theme.glass { return #ffffff17; }
        if style == TileStyle.inverse { return Theme.c.ink-inverse.with-alpha(0.12); }
        if style == TileStyle.accent { return Theme.c.on-accent.with-alpha(0.12); }
        if style == TileStyle.soft { return Theme.c.surface.with-alpha(0.7); }
        return Theme.c.surface-muted;
    }
    // The strong fill (bars, progress) on the given tile.
    public pure function strong(style: TileStyle) -> color {
        if Theme.glass { return Theme.c.ink; }
        if style == TileStyle.inverse { return Theme.c.ink-inverse; }
        if style == TileStyle.accent { return Theme.c.on-accent; }
        return Theme.c.surface-inverse;
    }
}

// Frosted panel background, drawn as the first child of a panel and filling
// it. The blurred backdrop is placed at window coordinates, so the panel shows
// exactly the part of the aurora that lies behind it, frosted.
export component GlassFill inherits Rectangle {
    in property <color> tint: Glass.tint;
    in property <color> wash: transparent;   // colour over the tint (accent panels)
    in property <color> glow: transparent;   // light blooming from the top-left
    in property <bool> edge: true;
    clip: true;
    if !Glass.solid: Image {
        x: -root.absolute-position.x;
        y: -root.absolute-position.y - Glass.shift;
        width: Glass.win-width;
        height: Glass.win-height + Glass.travel;
        source: Glass.frost;
        image-fit: fill;
    }
    Rectangle { background: Glass.solid ? Glass.tint-solid : root.tint; }
    if root.wash != transparent: Rectangle { background: root.wash; }
    if root.glow != transparent: Rectangle {
        x: -parent.width * 0.4;
        y: -parent.width * 0.62;
        width: parent.width * 1.3;
        height: self.width;
        background: @radial-gradient(circle, root.glow 0%, root.glow.with-alpha(0) 68%);
    }
    Rectangle { background: Glass.sheen; }
    if root.edge: Rectangle {
        border-radius: root.border-radius;
        border-width: 1px;
        border-color: Glass.edge;
    }
}

// Light that blooms under the finger on glass controls and fades on release.
export component TouchGlow inherits Rectangle {
    in property <bool> active;
    in property <length> px;
    in property <length> py;
    in property <length> radius: 64px;
    in property <color> tone: #ffffff;
    x: root.px - root.radius;
    y: root.py - root.radius;
    width: root.radius * 2;
    height: self.width;
    background: @radial-gradient(circle, root.tone.with-alpha(0.26) 0%, root.tone.with-alpha(0.08) 40%, root.tone.with-alpha(0) 70%);
    opacity: root.active ? 1 : 0;
    animate opacity { duration: root.active ? 60ms : 420ms; easing: ease-out; }
}

export component Caption inherits Text {
    in property <TileStyle> on: TileStyle.surface;
    font-size: Type.caption;
    font-weight: 500;
    color: Ink.muted(on);
    overflow: elide;
}

export component Label inherits Text {
    in property <TileStyle> on: TileStyle.surface;
    font-size: Type.label;
    font-weight: 500;
    color: Ink.fg(on);
    overflow: elide;
}

export component CardTitle inherits Text {
    in property <TileStyle> on: TileStyle.surface;
    font-size: Type.h3;
    font-weight: 600;
    letter-spacing: -0.16px;
    color: Ink.fg(on);
    overflow: elide;
    vertical-alignment: center;
}

// A number with an optional unit set smaller beside it ("29,894.81 SAR").
// Long numbers shrink instead of being cut off.
export component Amount inherits HorizontalLayout {
    in property <string> value;
    in property <string> unit;
    in property <TileStyle> on: TileStyle.surface;
    in property <length> size: Type.metric-md;
    in property <color> color: Ink.fg(on);
    // amounts shown side by side pass the longest length so they match
    in property <int> fit-chars: value.character-count;
    property <int> chars: fit-chars;
    property <length> fitted: chars > 12 ? size * 0.66 : chars > 10 ? size * 0.76 : chars > 8 ? size * 0.88 : size;
    spacing: 6px;
    alignment: start;
    Text {
        text: root.value;
        font-size: root.fitted;
        font-weight: 500;
        letter-spacing: root.fitted * -0.035;
        color: root.color;
        vertical-alignment: bottom;
    }
    if root.unit != "": Text {
        text: root.unit;
        font-size: Math.max(Type.caption, root.fitted * 0.32);
        font-weight: 600;
        color: Ink.muted(root.on);
        vertical-alignment: bottom;
        // optical baseline match with the big digits
        height: root.fitted * 0.98;
    }
}

// Two-weight page title: first word muted/400, second ink/600.
export component PageTitle inherits VerticalLayout {
    in property <string> first;
    in property <string> second;
    spacing: -8px;
    padding-top: 4px;
    padding-bottom: 4px;
    Text {
        text: first;
        font-size: Type.display;
        font-weight: 400;
        letter-spacing: -1.4px;
        color: Theme.c.ink-muted;
    }
    Text {
        text: second;
        font-size: Type.display;
        font-weight: 600;
        letter-spacing: -1.4px;
        color: Theme.c.ink;
    }
}

// Base bento card. Children are stacked in a vertical layout.
export component Tile inherits Rectangle {
    in property <TileStyle> style: TileStyle.surface;
    in property <length> pad: Theme.space-6;
    in property <length> inner-spacing: Theme.space-4;
    in property <bool> small: false;
    // position in the entrance stagger (0 = first)
    in property <int> order: 0;
    property <bool> shown: false;
    init => { self.shown = true; }
    border-radius: small ? Theme.radius-md : Theme.radius-lg;
    background: Ink.bg(style);
    clip: true;
    opacity: shown ? 1 : 0;
    transform-scale: shown ? 1 : Motion.rise;
    animate opacity { duration: Motion.quick * 1.6; delay: Motion.stagger * root.order; easing: ease-out; }
    animate transform-scale { duration: Motion.smooth; delay: Motion.stagger * root.order; easing: spring(0); }
    if Theme.glass: GlassFill {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        tint: root.style == TileStyle.inverse ? Glass.tint-hero
            : root.style == TileStyle.accent ? Glass.tint-accent
            : Glass.tint;
        // kept low: brighter colour fails 4.5:1 for captions (aurora.rs tests)
        wash: root.style == TileStyle.accent ? Theme.c.accent.with-alpha(0.12)
            : root.style == TileStyle.soft ? Theme.c.accent.with-alpha(0.06)
            : transparent;
        glow: root.style == TileStyle.inverse ? Theme.c.accent.with-alpha(0.08) : transparent;
    }
    VerticalLayout {
        padding: small ? Theme.space-4 : root.pad;
        spacing: root.inner-spacing;
        @children
    }
}

// Circle icon button.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <IconButtonStyle> kind: IconButtonStyle.surface;
    in property <bool> small: false;
    in property <bool> enabled: true;
    in property <color> outline-color: Theme.c.ink;
    in property <string> label;
    callback clicked;

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    width: small ? Theme.control-md : Theme.control-lg;
    height: self.width;
    border-radius: self.width / 2;
    clip: Theme.glass;
    // disabled: an empty outlined circle with a faint icon, not a faded fill
    background: !enabled ? transparent
        : kind == IconButtonStyle.inverse ? Theme.c.surface-inverse
        : kind == IconButtonStyle.accent ? Theme.c.accent
        : kind == IconButtonStyle.muted ? Theme.c.surface-muted
        : kind == IconButtonStyle.outline ? transparent
        : kind == IconButtonStyle.glass ? Glass.dark
        : Theme.c.surface;
    border-width: !enabled || kind == IconButtonStyle.outline || kind == IconButtonStyle.glass ? 1px : 0px;
    border-color: !enabled ? Theme.c.line
        : kind == IconButtonStyle.glass ? Glass.dark-edge : outline-color.with-alpha(0.35);
    transform-scale: ta.pressed ? 0.92 : 1;
    animate transform-scale { duration: Motion.press; easing: spring(0.2); }
    animate background { duration: Motion.quick; }

    if Theme.glass: TouchGlow { active: ta.pressed; px: ta.mouse-x; py: ta.mouse-y; radius: 40px; }
    Icon {
        data: root.icon;
        stroke: !root.enabled ? Theme.c.ink-subtle
            : kind == IconButtonStyle.inverse ? Theme.c.ink-inverse
            : kind == IconButtonStyle.accent ? Theme.c.on-accent
            : kind == IconButtonStyle.outline ? root.outline-color
            : kind == IconButtonStyle.glass ? Glass.dark-ink
            : Theme.c.ink;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Pill button (48px, 40px when small).
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <ButtonStyle> kind: ButtonStyle.inverse;
    in property <bool> small: false;
    in property <bool> enabled: true;
    // the surface a ghost button sits on
    in property <TileStyle> on: TileStyle.muted;
    callback clicked;

    property <color> fg: kind == ButtonStyle.accent ? Theme.c.on-accent
        : kind == ButtonStyle.ghost ? Ink.fg(on == TileStyle.muted ? TileStyle.surface : on)
        : kind == ButtonStyle.danger ? #ffffff
        : Theme.c.ink-inverse;

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    height: small ? Theme.control-md : Theme.control-lg;
    min-width: lay.preferred-width;
    border-radius: self.height / 2;
    background: kind == ButtonStyle.accent ? Theme.c.accent
        : kind == ButtonStyle.ghost ? transparent
        : kind == ButtonStyle.danger ? Theme.c.negative
        : Theme.c.surface-inverse;
    border-width: kind == ButtonStyle.ghost ? 1px : 0px;
    border-color: on == TileStyle.inverse && !Theme.glass ? Theme.c.ink-inverse.with-alpha(0.3) : Theme.c.line;
    opacity: enabled ? 1 : 0.4;
    clip: Theme.glass;
    transform-scale: ta.pressed ? 0.97 : 1;
    animate transform-scale { duration: Motion.press; easing: spring(0.2); }
    // the primary action glows softly on glass
    drop-shadow-blur: Theme.glass && kind == ButtonStyle.accent ? 24px : 0px;
    drop-shadow-color: Theme.c.accent.with-alpha(0.35);

    if Theme.glass: TouchGlow {
        active: ta.pressed;
        px: ta.mouse-x;
        py: ta.mouse-y;
        tone: kind == ButtonStyle.accent ? #ffffff : Theme.c.accent;
    }
    lay := HorizontalLayout {
        padding-left: small ? Theme.space-4 : Theme.space-6;
        padding-right: self.padding-left;
        spacing: Theme.space-2;
        alignment: center;
        if root.icon != "": Icon {
            data: root.icon;
            stroke: root.fg;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: small ? 13px : 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Filter / choice pill.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active: false;
    in property <bool> accent: false;
    in property <bool> outline: false;
    in property <color> swatch: transparent;
    // the surface the chip sits on, so it stays visible
    in property <TileStyle> on: TileStyle.muted;
    callback clicked;

    property <color> fg: active ? Theme.c.ink-inverse : accent ? Theme.c.on-accent : Ink.fg(on == TileStyle.muted ? TileStyle.surface : on);

    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }

    height: Theme.control-md;
    min-width: lay.preferred-width;
    border-radius: self.height / 2;
    clip: Theme.glass;
    background: active ? Theme.c.surface-inverse
        : accent ? Theme.c.accent
        : outline ? transparent
        : on == TileStyle.muted ? Theme.c.surface
        : Ink.raised(on);
    border-width: outline && !active ? 1px : 0px;
    border-color: Theme.c.line;
    animate background { duration: Motion.quick; }
    transform-scale: ta.pressed ? 0.95 : 1;
    animate transform-scale { duration: Motion.press; easing: spring(0.2); }

    if Theme.glass && !root.active: TouchGlow { active: ta.pressed; px: ta.mouse-x; py: ta.mouse-y; radius: 48px; }

    lay := HorizontalLayout {
        padding-left: root.icon != "" || root.swatch != transparent ? 12px : Theme.space-4;
        padding-right: Theme.space-4;
        spacing: 6px;
        alignment: center;
        if root.swatch != transparent: Rectangle {
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: root.swatch;
        }
        if root.icon != "": Icon {
            data: root.icon;
            size: 16px;
            stroke: root.fg;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: Type.label;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Square category button: icon above the name, four to a row.
export component CategoryTile inherits Rectangle {
    in property <string> name;
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    accessible-role: button;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }
    // equal columns whatever the name length
    horizontal-stretch: 1;
    preferred-width: 1px;
    height: 68px;
    border-radius: Theme.radius-sm;
    clip: true;
    background: active ? Theme.c.surface-inverse : Theme.c.surface;
    border-width: Theme.glass && !active ? 1px : 0px;
    border-color: #ffffff14;
    animate background { duration: Motion.quick; }
    transform-scale: ta.pressed ? 0.94 : 1;
    animate transform-scale { duration: Motion.press; easing: spring(0.2); }
    if Theme.glass && !root.active: TouchGlow { active: ta.pressed; px: ta.mouse-x; py: ta.mouse-y; radius: 48px; }
    VerticalLayout {
        padding: 6px;
        spacing: 5px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Icon {
                data: root.icon;
                size: 22px;
                stroke: root.active ? Theme.c.ink-inverse : Theme.c.ink;
            }
        }
        Text {
            text: root.name;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
            color: root.active ? Theme.c.ink-inverse : Theme.c.ink;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Delta badge with an arrow; colour is never the only signal.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> up: true;
    // colour follows meaning, not direction: spending up is bad
    in property <bool> bad: !self.up;
    in property <bool> neutral: false;
    horizontal-stretch: 0;
    height: 22px;
    min-width: lay.preferred-width;
    border-radius: 11px;
    background: neutral ? Theme.c.surface-muted : bad ? Theme.c.negative.with-alpha(0.14) : Theme.c.positive.with-alpha(0.14);
    lay := HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 2px;
        alignment: center;
        if !root.neutral: Icon {
            data: root.up ? Icons.arrow-up : Icons.arrow-down;
            size: 12px;
            stroke-width: 2.2px;
            y: (parent.height - self.height) / 2;
            stroke: root.bad ? Theme.c.negative : Theme.c.positive;
        }
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
            color: root.neutral ? Theme.c.ink : root.bad ? Theme.c.negative : Theme.c.positive;
        }
    }
}

export component Progress inherits Rectangle {
    in property <float> value; // 0..1
    in property <color> track: Theme.glass ? #ffffff17 : Theme.c.surface-muted;
    in property <color> fill: Theme.c.accent;
    in property <float> marker: -1; // optional pace marker 0..1
    in property <length> thickness: 8px;
    property <bool> shown: false;
    init => { self.shown = true; }
    height: thickness;
    border-radius: self.height / 2;
    background: track;
    Rectangle {
        x: 0;
        // fills from the left when it appears, then follows the value
        width: !root.shown ? 0px : Math.max(root.value > 0 ? root.height : 0, parent.width * Math.clamp(root.value, 0, 1));
        height: parent.height;
        border-radius: parent.border-radius;
        background: root.fill;
        animate width { duration: Motion.smooth * 1.3; easing: spring(0); }
    }
    if root.marker >= 0: Rectangle {
        x: parent.width * Math.clamp(root.marker, 0, 1) - 1px;
        y: -3px;
        width: 2px;
        height: parent.height + 6px;
        border-radius: 1px;
        background: Theme.c.ink-muted;
    }
}

// Pill bar chart: base bars, one highlighted bar with a value bubble, empty bars muted.
// Every slot has a faint full-height track, so an empty day reads as empty
// and a small amount as a short bar. Bars grow from the baseline on entry.
export component Bars inherits VerticalLayout {
    in property <[Bar]> bars;
    in property <length> chart-height: 120px;
    in property <length> gap: 8px;
    in property <length> max-bar: 36px;
    in property <color> base: Theme.glass ? Theme.c.ink : Theme.c.surface-inverse;
    in property <color> track: Theme.glass ? #ffffff12 : Theme.c.surface-muted;
    in property <color> label-color: Theme.c.ink-muted;
    in property <color> tip-bg: Theme.glass ? #ffffff26 : Theme.c.surface;
    in property <color> tip-fg: Theme.c.ink;
    property <bool> shown: false;
    init => { self.shown = true; }
    spacing: Theme.space-2;

    row := HorizontalLayout {
        height: root.chart-height + 30px;
        spacing: root.gap;
        for bar[i] in root.bars: Rectangle {
            property <length> bw: Math.min(self.width, root.max-bar);
            property <length> fill-h: bar.empty ? 0px : Math.max(Math.min(bw, 6px), root.chart-height * Math.min(bar.value, 1));
            // track
            Rectangle {
                width: parent.bw;
                height: root.chart-height;
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height;
                border-radius: self.width / 2;
                background: root.track;
            }
            // value
            Rectangle {
                width: parent.bw;
                height: root.shown ? parent.fill-h : 0px;
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height;
                border-radius: Math.min(self.width, self.height) / 2;
                background: bar.highlight ? Theme.c.accent : root.base;
                animate height { duration: Motion.smooth * 1.2; delay: Motion.stagger * 0.5 * i; easing: spring(0.1); }
            }
            // off-scale: the bar is cut at the top of the chart; a notch says so
            if bar.over && !bar.empty: Rectangle {
                width: parent.bw + 2px;
                height: 3px;
                x: (parent.width - self.width) / 2;
                y: parent.height - root.chart-height + 9px;
                // a gap in the tile colour (dark on glass)
                background: Theme.glass ? #101417 : root.tip-bg.with-alpha(1);
                opacity: root.shown ? 1 : 0;
            }
            if bar.highlight && bar.tip != "": Rectangle {
                property <length> bar-h: Math.max(6px, root.chart-height * Math.min(bar.value, 1));
                y: Math.max(0px, parent.height - bar-h - self.height - 6px);
                // keep the bubble inside the chart
                x: Math.clamp((parent.width - self.width) / 2, -parent.x, row.width - parent.x - self.width);
                height: 24px;
                width: tip.preferred-width + 16px;
                border-radius: 12px;
                background: root.tip-bg;
                tip := Text {
                    text: bar.tip;
                    font-size: Type.caption;
                    font-weight: 700;
                    color: root.tip-fg;
                }
            }
        }
    }
    HorizontalLayout {
        spacing: root.gap;
        for bar in root.bars: Text {
            text: bar.label;
            horizontal-alignment: center;
            font-size: Type.micro;
            font-weight: 600;
            color: root.label-color;
            wrap: no-wrap;
        }
    }
}

// Rows × 24 hours of dots; size and fill follow the amount. Peak cell in accent.
export component DotMatrix inherits VerticalLayout {
    in property <[string]> row-labels;
    in property <[float]> cells;   // row-major, rows × 24, 0..1
    in property <int> peak: -1;    // index of the peak cell
    spacing: 5px;
    for label[r] in root.row-labels: HorizontalLayout {
        Text {
            text: label;
            width: 34px;
            font-size: Type.micro;
            font-weight: 600;
            color: Theme.c.ink-muted;
            vertical-alignment: center;
        }
        for c in 24: Rectangle {
            property <float> v: root.cells[r * 24 + c];
            property <bool> is-peak: r * 24 + c == root.peak;
            height: 12px;
            Rectangle {
                width: v <= 0 ? 4px : 6px + 5px * Math.clamp(v, 0, 1);
                height: self.width;
                border-radius: self.width / 2;
                background: is-peak ? Theme.c.accent
                    : v <= 0 ? Theme.c.ink-subtle.with-alpha(0.35)
                    : Theme.c.ink.with-alpha(0.25 + 0.75 * Math.clamp(v, 0, 1));
            }
        }
    }
    HorizontalLayout {
        padding-left: 34px;
        for h in ["00", "", "", "", "", "", "06", "", "", "", "", "", "12", "", "", "", "", "", "18", "", "", "", "", "23"]: Text {
            text: h;
            font-size: Type.micro;
            font-weight: 600;
            color: Theme.c.ink-muted;
            horizontal-alignment: center;
            wrap: no-wrap;
        }
    }
}

// 40px icon circle, two-line text, right-aligned value.
export component ListRow inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> meta;
    in property <string> value;
    in property <string> value-meta;
    in property <bool> positive: false;
    in property <bool> negative: false;
    in property <bool> selected: false;
    in property <TileStyle> on: TileStyle.surface;
    in property <color> icon-bg: Ink.raised(on);
    callback clicked;

    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.value;
    accessible-action-default => { root.clicked(); }

    height: 60px;
    border-radius: Theme.radius-md;
    clip: Theme.glass;
    background: selected ? Theme.c.surface-muted : ta.pressed ? Theme.c.surface-muted.with-alpha(0.6) : transparent;
    animate background { duration: Motion.quick; }

    if Theme.glass: TouchGlow { active: ta.pressed; px: ta.mouse-x; py: ta.mouse-y; radius: 80px; }

    HorizontalLayout {
        padding-left: root.selected ? Theme.space-3 : 0px;
        padding-right: root.selected ? Theme.space-3 : 0px;
        spacing: Theme.space-3;
        alignment: stretch;
        Rectangle {
            width: 40px;
            height: 40px;
            y: (parent.height - self.height) / 2;
            border-radius: 20px;
            background: root.icon-bg;
            Icon { data: root.icon; stroke: Ink.fg(root.on); }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: Type.body - 1px;
                font-weight: 600;
                color: Ink.fg(root.on);
                overflow: elide;
            }
            Text {
                text: root.meta;
                font-size: Type.caption;
                font-weight: 500;
                color: Ink.muted(root.on);
                overflow: elide;
            }
        }
        @children
        if root.value != "": VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.value;
                font-size: Type.body - 1px;
                font-weight: 600;
                horizontal-alignment: right;
                color: root.positive ? Theme.c.positive : root.negative ? Theme.c.negative : Ink.fg(root.on);
            }
            if root.value-meta != "": Text {
                text: root.value-meta;
                font-size: Type.caption;
                font-weight: 500;
                horizontal-alignment: right;
                color: Ink.muted(root.on);
            }
        }
    }
    ta := TouchArea {
        clicked => {
            // a row can grow into the editor: remember where it is
            Morph.from(root.absolute-position.x, root.absolute-position.y, root.width, root.height,
                Theme.radius-md, Theme.glass ? #1a1f22 : Theme.c.surface);
            root.clicked();
        }
    }
}

// Segmented pill nav. The active pill glides between items on a spring.
export component PillNav inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current: 0;
    in property <TileStyle> on: TileStyle.muted;
    callback changed(int);
    property <length> item-w: (self.width - 12px - (root.items.length - 1) * Theme.space-1) / Math.max(1, root.items.length);
    height: Theme.control-md + 12px;
    border-radius: self.height / 2;
    background: Theme.glass ? #ffffff14 : on == TileStyle.muted ? Theme.c.surface : Ink.raised(on);
    border-width: Theme.glass ? 1px : 0px;
    border-color: #ffffff14;
    // the gliding thumb
    if root.current >= 0 && root.current < root.items.length: Rectangle {
        x: 6px + root.current * (root.item-w + Theme.space-1);
        y: 6px;
        width: root.item-w;
        height: parent.height - 12px;
        border-radius: self.height / 2;
        background: Theme.c.surface-inverse;
        animate x { duration: Motion.snappy; easing: spring(0.15); }
    }
    // items are placed by hand (not in a layout) so each gets exactly the
    // slot the thumb glides to, whatever the label length
    for item[i] in root.items: Rectangle {
        x: 6px + i * (root.item-w + Theme.space-1);
        y: 6px;
        width: root.item-w;
        height: parent.height - 12px;
        accessible-role: tab;
        accessible-label: item;
        accessible-item-selected: i == root.current;
        accessible-action-default => {
            root.current = i;
            root.changed(i);
        }
        Text {
            text: item;
            font-size: Type.label;
            font-weight: i == root.current ? 600 : 500;
            color: i == root.current ? Theme.c.ink-inverse : Theme.c.ink-muted;
            animate color { duration: Motion.quick; }
        }
        TouchArea {
            clicked => {
                root.current = i;
                root.changed(i);
            }
        }
    }
}

export struct DockItem {
    icon: string,
    label: string,
}

// Floating dark-glass pill navigation, bottom centre. The accent disc glides
// to the current item.
export component Dock inherits Rectangle {
    in property <[DockItem]> items;
    in property <int> current: 0;
    callback selected(int);
    property <length> slot: Theme.control-lg + 6px;
    height: Theme.control-lg + 16px;
    width: lay.preferred-width;
    border-radius: self.height / 2;
    // rounded clip for the glass image (the shadow is drawn outside it)
    clip: Theme.glass;
    background: Theme.glass ? transparent : Glass.dark;
    border-width: Theme.glass ? 0px : 1px;
    border-color: Glass.dark-edge;
    drop-shadow-blur: 32px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: Theme.glass ? #000000a0 : #00000059;
    if Theme.glass: GlassFill {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        tint: #0a0d10cc;
    }
    // light catching the top edge of the glass
    if !Theme.glass: Rectangle {
        y: 1px;
        x: parent.height / 2;
        width: parent.width - parent.height;
        height: 1px;
        background: @linear-gradient(90deg, #ffffff00 0%, #ffffff33 50%, #ffffff00 100%);
    }
    // gliding accent disc
    Rectangle {
        x: 8px + Math.max(0, root.current) * root.slot;
        y: 8px;
        width: Theme.control-lg;
        height: Theme.control-lg;
        border-radius: self.width / 2;
        background: Theme.c.accent;
        opacity: root.current >= 0 ? 1 : 0;
        transform-scale: root.current >= 0 ? 1 : 0.6;
        drop-shadow-blur: Theme.glass ? 16px : 0px;
        drop-shadow-color: Theme.c.accent.with-alpha(0.45);
        animate x { duration: Motion.snappy; easing: spring(0.15); }
        animate opacity { duration: Motion.quick; }
        animate transform-scale { duration: Motion.snappy; easing: spring(0.15); }
    }
    lay := HorizontalLayout {
        padding: 8px;
        spacing: 6px;
        for item[i] in root.items: Rectangle {
            width: Theme.control-lg;
            height: Theme.control-lg;
            border-radius: self.width / 2;
            clip: true;
            background: i != root.current && ta.pressed ? #ffffff14 : transparent;
            accessible-role: tab;
            accessible-label: item.label;
            accessible-item-selected: i == root.current;
            accessible-action-default => { root.selected(i); }
            animate background { duration: Motion.quick; }
            transform-scale: ta.pressed ? 0.9 : 1;
            animate transform-scale { duration: Motion.press; easing: spring(0.2); }
            if Theme.glass: TouchGlow { active: ta.pressed; px: ta.mouse-x; py: ta.mouse-y; radius: 36px; }
            Icon {
                data: item.icon;
                stroke: i == root.current ? Theme.c.on-accent : Glass.dark-ink;
                animate stroke { duration: Motion.quick; }
            }
            ta := TouchArea {
                clicked => {
                    Morph.from(self.absolute-position.x, self.absolute-position.y, self.width, self.height,
                        self.width / 2, Theme.c.accent);
                    root.selected(i);
                }
            }
        }
    }
}

// Card with the signature notched top-right corner holding one round action.
// The outline is one path, so the bite shows whatever is behind the card.
export component NotchCard inherits Rectangle {
    in property <TileStyle> style: TileStyle.surface;
    in property <string> icon: Icons.arrow-up-right;
    in property <string> label;
    in property <IconButtonStyle> button-kind: IconButtonStyle.inverse;
    callback action;

    property <float> w: self.width / 1px;
    property <float> h: self.height / 1px;
    property <float> r: 28;   // card radius
    property <float> b: 56;   // bite: 48px button + 8px clearance
    property <float> f: 16;   // fillet radius
    in property <int> order: 0;
    property <bool> shown: false;
    init => { self.shown = true; }
    opacity: shown ? 1 : 0;
    transform-scale: shown ? 1 : Motion.rise;
    animate opacity { duration: Motion.quick * 1.6; delay: Motion.stagger * root.order; easing: ease-out; }
    animate transform-scale { duration: Motion.smooth; delay: Motion.stagger * root.order; easing: spring(0); }

    Path {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.w;
        viewbox-height: root.h;
        fill: !Theme.glass ? Ink.bg(root.style)
            : Glass.solid ? Glass.tint-solid
            : root.style == TileStyle.accent ? @linear-gradient(140deg, Theme.c.accent.mix(#0a0d10, 0.16).with-alpha(0.85) 0%, #0a0d10c4 60%, #0a0d10c4 100%)
            : Glass.tint;
        stroke: Theme.glass ? Glass.edge : transparent;
        stroke-width: Theme.glass ? 1px : 0;
        commands: "M 0 " + root.r
            + " A " + root.r + " " + root.r + " 0 0 1 " + root.r + " 0"
            + " L " + (root.w - root.b - root.f) + " 0"
            + " A " + root.f + " " + root.f + " 0 0 1 " + (root.w - root.b) + " " + root.f
            + " L " + (root.w - root.b) + " " + (root.b - root.f)
            + " A " + root.f + " " + root.f + " 0 0 0 " + (root.w - root.b + root.f) + " " + root.b
            + " L " + (root.w - root.f) + " " + root.b
            + " A " + root.f + " " + root.f + " 0 0 1 " + root.w + " " + (root.b + root.f)
            + " L " + root.w + " " + (root.h - root.r)
            + " A " + root.r + " " + root.r + " 0 0 1 " + (root.w - root.r) + " " + root.h
            + " L " + root.r + " " + root.h
            + " A " + root.r + " " + root.r + " 0 0 1 0 " + (root.h - root.r)
            + " Z";
    }

    VerticalLayout {
        padding: Theme.space-6;
        padding-right: root.b * 1px + Theme.space-2;
        spacing: Theme.space-2;
        @children
    }

    btn := IconButton {
        x: parent.width - self.width;
        y: 0;
        icon: root.icon;
        kind: root.button-kind;
        label: root.label;
        clicked => {
            Morph.from(self.absolute-position.x, self.absolute-position.y, self.width, self.height,
                self.width / 2, Theme.glass ? Theme.c.accent : Theme.c.surface-inverse);
            root.action();
        }
    }
}

// Rounded text input with a caption above.
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <string> icon;
    in property <InputType> input-type: InputType.text;
    in property <TileStyle> on: TileStyle.surface;
    in-out property <string> text;
    callback edited(string);
    callback accepted(string);
    spacing: Theme.space-2;
    if root.label != "": Caption { text: root.label; on: root.on; }
    Rectangle {
        height: Theme.control-lg;
        border-radius: self.height / 2;
        background: root.on == TileStyle.muted ? Theme.c.surface : Ink.raised(root.on);
        border-width: input.has-focus ? 2px : Theme.glass ? 1px : 0px;
        border-color: input.has-focus ? Theme.c.accent-ink : #ffffff14;
        HorizontalLayout {
            padding-left: root.icon != "" ? 14px : Theme.space-5;
            padding-right: Theme.space-5;
            spacing: Theme.space-2;
            if root.icon != "": Icon {
                data: root.icon;
                stroke: Theme.c.ink-muted;
                y: (parent.height - self.height) / 2;
            }
            Rectangle {
                horizontal-stretch: 1;
                input := TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.text;
                    input-type: root.input-type;
                    vertical-alignment: center;
                    font-size: Type.body;
                    color: Theme.c.ink;
                    selection-background-color: Theme.c.accent;
                    selection-foreground-color: Theme.c.on-accent;
                    single-line: true;
                    accessible-label: root.label != "" ? root.label : root.placeholder;
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(self.text); }
                }
                if root.text == "": Text {
                    x: 0;
                    width: 100%;
                    height: 100%;
                    text: root.placeholder;
                    font-size: Type.body;
                    color: Theme.c.ink-muted;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Horizontally scrolling row of chips.
export component ChipScroller inherits Flickable {
    height: Theme.control-md;
    content-width: row.preferred-width;
    content-height: self.height;
    row := HorizontalLayout {
        spacing: Theme.space-2;
        @children
    }
}

// Small figure with caption, used in stat grids.
export component Figure inherits VerticalLayout {
    // equal columns: let the layout share the width, not the content
    preferred-width: 1px;
    horizontal-stretch: 1;
    in property <string> caption;
    in property <string> value;
    in property <string> unit;
    in property <string> note;
    in property <TileStyle> on: TileStyle.surface;
    spacing: 2px;
    Caption { text: root.caption; on: root.on; }
    Amount { value: root.value; unit: root.unit; size: Type.metric-sm; on: root.on; }
    if root.note != "": Caption { text: root.note; on: root.on; }
}

// Dark glass toast with an optional action, above the dock.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <string> action;
    callback act();
    height: 48px;
    border-radius: 24px;
    clip: Theme.glass;
    background: Theme.glass ? transparent : Glass.dark;
    border-width: Theme.glass ? 0px : 1px;
    border-color: Glass.dark-edge;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000070;
    // slides up and fades in when it appears
    property <bool> shown: false;
    init => { self.shown = true; }
    opacity: shown ? 1 : 0;
    transform-scale: shown ? 1 : 0.92;
    animate opacity { duration: Motion.quick; }
    animate transform-scale { duration: Motion.snappy; easing: spring(0.15); }
    if Theme.glass: GlassFill {
        width: 100%;
        height: 100%;
        border-radius: root.border-radius;
        tint: #0a0d10d9;
    }
    HorizontalLayout {
        padding-left: Theme.space-5;
        padding-right: 6px;
        spacing: Theme.space-3;
        Text {
            text: root.text;
            color: Glass.dark-ink;
            font-size: Type.label;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.action != "": Rectangle {
            width: act-text.preferred-width + 28px;
            height: 36px;
            y: (parent.height - self.height) / 2;
            border-radius: 18px;
            background: Theme.c.accent;
            accessible-role: button;
            accessible-label: root.action;
            accessible-action-default => { root.act(); }
            act-text := Text {
                text: root.action;
                color: Theme.c.on-accent;
                font-size: Type.label;
                font-weight: 700;
            }
            TouchArea { clicked => { root.act(); } }
        }
    }
}

// One card header everywhere: optional icon, title, then one badge and/or one
// round action on the right; always the height of a small button.
export component CardHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> icon;
    in property <TileStyle> on: TileStyle.surface;
    in property <string> badge;
    in property <bool> badge-up: true;
    in property <bool> badge-bad: !self.badge-up;
    in property <string> action-icon;
    in property <string> action-label;
    callback action();
    height: Theme.control-md;
    spacing: Theme.space-2;
    if root.icon != "": Icon {
        data: root.icon;
        stroke: Ink.fg(root.on);
        y: (parent.height - self.height) / 2;
    }
    CardTitle { text: root.title; on: root.on; horizontal-stretch: 1; }
    @children
    if root.badge != "": Badge {
        text: root.badge;
        up: root.badge-up;
        bad: root.badge-bad;
        y: (parent.height - self.height) / 2;
    }
    if root.action-icon != "": IconButton {
        icon: root.action-icon;
        small: true;
        kind: root.on == TileStyle.inverse && !Theme.glass ? IconButtonStyle.surface : IconButtonStyle.muted;
        label: root.action-label;
        clicked => { root.action(); }
    }
}

// Accent choice: colour dot over the name; four share a row equally.
export component Swatch inherits Rectangle {
    in property <string> name;
    in property <color> tone;
    in property <bool> active;
    callback clicked;
    accessible-role: button;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }
    horizontal-stretch: 1;
    preferred-width: 1px;
    height: 64px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.c.surface-inverse : Ink.raised(TileStyle.surface);
    animate background { duration: Motion.quick; }
    transform-scale: ta.pressed ? 0.94 : 1;
    animate transform-scale { duration: Motion.press; easing: spring(0.2); }
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: root.tone;
                border-width: 2px;
                border-color: root.active ? Theme.c.ink-inverse.with-alpha(0.25) : transparent;
            }
        }
        Text {
            text: root.name;
            font-size: Type.caption;
            font-weight: 600;
            horizontal-alignment: center;
            color: root.active ? Theme.c.ink-inverse : Theme.c.ink;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}
